// 스크롤 탑으로 이동
function sclTop(tar, ft, dur) {
    var mov = 0;
	var $doc = $("html, body");

    if ((dur == null) || (dur == undefined)) {
        dur = 500;
    }

    if (ft != null) {
        mov = ft;
    }

	$("html").velocity("stop");

    if (tar == null) {
		$("html").velocity("scroll", { offset: 0 + mov, duration: dur, mobileHA: false });
    } else {
		$("html").velocity("scroll", { offset: $(tar).offset().top + mov, duration: dur, mobileHA: false });
    }
}

