    });

    xdsPc = new xds(protocol + '//www.yes24.com/Product/Scripts/Common/XDS/xds-serve.html?v=20200410');
    srchHistory = {
        add: function (val) {
            if ($.trim(val) == "")
                return;

            xdsPc.getItem("scrHistory", function (allval, response) {
                if (allval == null || allval.length == 0)
                    xdsPc.setItem("scrHistory", val);
                else {
                    var arrHistory = allval.split('。');
                    var listcount = 0;

                    var strHistory = "";
                    for (var i = 0; i < arrHistory.length; i++) {
                        if (arrHistory[i] == $.trim(val))
                            continue;

                        if (strHistory == "")
                            strHistory = arrHistory[i];
                        else
                            strHistory += "。" + arrHistory[i];

                        listcount++;

                        if (listcount == 9)
                            break;
                    }

                    strHistory = $.trim(val) + "。" + strHistory;
                    xdsPc.setItem("scrHistory", strHistory);
                }
            });
        },
        removeItem: function (searchword) {
            xdsPc.getItem("scrHistory", function (allval, response) {
                var current_val = allval.replace(searchword + "。", "");
                xdsPc.setItem("scrHistory", current_val);
            });
            $("#latestSearchList").css("display", "");
            $("#searchKeyLayer").css("display", "");
        },
        removeItem: function (searchword) {
            xdsPc.getItem("scrHistory", function (allval, response) {
                var searchword_array = allval.split('。');
                var join_searchword = '';
                var current_idx = 0;
                $.each(searchword_array, function (i, v) {
                    if (v == searchword) {
                        current_idx = i;
                    }
                    else {
                        join_searchword += (searchword_array.length - 1) == i ? searchword_array[i] : searchword_array[i] + '。';
                    }
                });

                if (join_searchword.charAt(join_searchword.length - 1) == '。') {
                    join_searchword = join_searchword.slice(0, -1);
                }
                searchword_array.splice(current_idx, 1);
                xdsPc.setItem("scrHistory", join_searchword);
                srchHistory.show();
            });
            $("#latestSearchList").css("display", "");
            $("#searchKeyLayer").css("display", "");
        },
        clear: function () {
            xdsPc.setItem("scrHistory", "");
            $("#latestSearchList dd").empty();
            $("<div class=\"noData\"><p class=\"txt_tit\">최근 검색어가 없습니다.</p></div>").appendTo("#latestSearchList dd");

        },
        show: function () {
            if ($("#query").val() != "")
                return;
            xdsPc.getItem("scrHistory", function (allval, response) {
                if (allval == null || allval.length == 0) {
                    $("#latestSearchList dd").empty();
                    $("<div class=\"noData\"><p class=\"txt_tit\">최근 검색어가 없습니다.</p></div>").appendTo("#latestSearchList dd");
                    $("#latestDelAll").css("display", "none");
                }
                else {
                    $("#latestDelAll").css("display", "");
                    var arrHistory = allval.split('。');
                    $("#latestSearchList dd").empty();
                    var historyCount = arrHistory.length;
                    if (historyCount > 10)
                        historyCount = 10;
                    var searchword_text = "<ul>";
                    for (var i = 0; i < historyCount; i++) {
                        if ($.trim(arrHistory[i]) != "") {
                            var url = protocol + "//www.yes24.com/product/search?query=" + encodeSearchQuery($.trim(arrHistory[i].replace('&#39;', '\'')));
                            var searchword = "<li><a href=\"" + url + "\" class=\"lnk_key\" onclick=\"BulletSearchRenewal.clickLoggingTrace('110_001');\">" + srchHistory.encodeHtmlEntities($.trim(arrHistory[i])) + "</a><a href='javascript:void(0);' class=\"lnk_del\" onclick='removeSearchItem(this,\"" + $.trim(arrHistory[i]) + "\");'><em id=\"latestDel\" class=\"ico_del\">삭제</em></a></li>";
                            searchword_text += searchword;
                        }
                    }
                    searchword_text += "</ul>";
                    $(searchword_text).appendTo("#latestSearchList dd");
                }
            });

        },
        hide: function () {
            $('#latestSearchList').show();
            $('#searchKeyLayer').show();
        },
        decodeHtmlEntities: function (val) { // HTML 특수문자 디코딩
            var decodeHtmlEntity = document.createElement('textarea');
            decodeHtmlEntity.innerHTML = val;
            return decodeHtmlEntity.value;
        },
        encodeHtmlEntities: function (val) { // HTML 특수문자 인코딩
            var encdoeHtmlEntity = document.createElement('div');
            encdoeHtmlEntity.innerText  = val;
            return encdoeHtmlEntity.innerHTML;
        }
    };
    srchHistory.show();
    setRemoveSearchword();
});

