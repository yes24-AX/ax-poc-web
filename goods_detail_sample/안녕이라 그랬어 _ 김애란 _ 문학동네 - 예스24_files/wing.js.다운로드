var goSubMenu = function (categoryNo) {
    if (categoryNo != null && categoryNo != '') {
        var header = MOBILE_URL;
        if (header.indexOf('https://') >= 0) {
            try {
                header = header.split(':')[0] + ':' + header.split(':')[1];
            } catch (e) { }
        }

        if (categoryNo.indexOf('018') == 0) {
            document.location.href = header + '/Category/DisplayUsed/' + categoryNo;
        }
        else if (categoryNo.indexOf('981') == 0) {
            document.location.href = 'http://m.fashion.yes24.com/Category/' + categoryNo;
        }
        else {
            document.location.href = header + '/category/display/' + categoryNo;
        }
    }
}
