			"viewSide": {
				rgt: { next: spineLft ? "viewFront" : "viewBack", angle: spineLft ? -40 : -140 },
				lft: { next: spineLft ? "viewBack" : "viewFront", angle: spineLft ? 140 : 40 }
			},
			"viewBack": {
				rgt: { next: spineLft ? "viewSide" : "viewFront", angle: spineLft ? -140 : -180 },
				lft: { next: spineLft ? "viewFront" : "viewSide", angle: spineLft ? 180 : 140 }
			}
		};

		var direction = angleMap[nowClass][dir];
		target.removeClass(nowClass).addClass(direction.next);
		$("#gdSizeWrap").removeClass(nowClass).addClass(direction.next);
		nowSizeAngle += direction.angle;

		// viewBack 인 경우에만 translate3d 값 조정
		if (direction.next === "viewBack") {
			tar3d = `translate3d(0, 0, ${gdImgSideW}px)`;
		}

		target.find(".img_item").css('transform', `rotate3d(0, 1, 0, ${nowSizeAngle}deg) ${tar3d}`);
	}
}

// 앵글 변경
var isAngleChging = false;
function chgRealTp(tp) {
	var realImg = $("#gdSizeWrap .size3dCon .size3dUnit");
	var realBook = $("#gdSizeWrap .size3dCon .size3dUnit .img_item");
	var realBookSideImg;
	var realSideW = 0;
	var rotateAmount, sideAmount;

	if (isAngleChging) return;  // 중복 호출 방지
	isAngleChging = true;

	function applyTransform(rotateDelta, translateDelta = 0) {
		nowSizeAngle += rotateDelta;
		realBook.css({ "transform": `rotate3d(0,1,0,${nowSizeAngle}deg) translate3d(0, 0, ${translateDelta}px)` });
	}

	switch (tp) {
		case "front":
			if (realImg.hasClass("viewSide") || realImg.hasClass("viewBack")) {
				rotateAmount = realImg.hasClass("spineLft") ? -40 : 40;
				if (realImg.hasClass("viewBack")) rotateAmount *= 4.5;
				applyTransform(rotateAmount);
				realImg.removeClass("viewSide viewBack").addClass("viewFront");
				$("#gdSizeWrap").removeClass("viewSide viewBack").addClass("viewFront");
			}
			break;
		case "side":
			if (realImg.hasClass("viewFront") || realImg.hasClass("viewBack")) {
				rotateAmount = realImg.hasClass("spineLft") ? 40 : -40;
				console.log("1 rotateAmount " + rotateAmount)
				if (realImg.hasClass("viewBack")) rotateAmount *= -3.5;
				console.log("2 rotateAmount " + rotateAmount)
				applyTransform(rotateAmount);
				realImg.removeClass("viewFront viewBack").addClass("viewSide");
				$("#gdSizeWrap").removeClass("viewFront viewBack").addClass("viewSide");
			}
			break;
		case "back":
			if (realImg.hasClass("viewSide") || realImg.hasClass("viewFront")) {
				realBookSideImg = $("#gdSizeWrap .size3dCon .size3dUnit ." + (realImg.hasClass("spineLft") ? "sideL" : "sideR") + " img");
				realSideW = realBookSideImg.width();
				rotateAmount = realImg.hasClass("spineLft") ? 140 : -140;
				if (realImg.hasClass("viewFront")) rotateAmount *= 1.2857;
				applyTransform(rotateAmount, Math.floor(realSideW));
				realImg.removeClass("viewFront viewSide").addClass("viewBack");
				$("#gdSizeWrap").removeClass("viewFront viewSide").addClass("viewBack");
			}
			break;
	}
	// 작업 완료 후 플래그를 다시 false로 설정
	setTimeout(() => { isAngleChging = false; }, 300);  // 300ms 딜레이 후 다시 호출 가능
}

// 사이즈 계산
function calcGDSize() {
	var a4Width = 210; // A4 사이즈
	var a4Height = 297; // A4 사이즈
	var cardWidth = 54; // 카드 사이즈
	var cardHeight = 86; // 카드 사이즈
	var tarBase = $("#gdSizeWrap");

	// 사이즈 모드인지 3D모드인지
	if (tarBase.hasClass("mod_size")) {
		var baseWidth = $(window).width() - 85;
		var baseHeight = $(window).height();

		if (baseWidth > 600) {
			baseWidth = 600;
		}

		if (baseHeight < 450) {
			if (baseHeight < 360) {
				baseWidth = 180;
			} else {
				baseWidth = 200;
			}
		}

		if (baseWidth + 200 > baseHeight) {
			baseWidth = baseHeight - 200;
		}

		// 사이즈 모드인지 3D모드인지
		if (tarBase.hasClass("mod_size")) {
			var tarG = tarBase.find(".img_book");

			if (tarBase.hasClass("sizeIs_card")) {
				var tarO = tarBase.find(".sizeCon .img_card");
				var tarGW = Math.floor(baseWidth * realBWidth / (realBWidth + cardWidth));
				var tarOW = baseWidth - tarGW;

				tarG.css("width", tarGW + "px");
				tarO.css("width", tarOW + "px");
			} else {
				var tarO = tarBase.find(".sizeCon .img_paper");
				var tarGW = Math.floor(baseWidth * realBWidth / (realBWidth + a4Width));
				var tarOW = baseWidth - tarGW;

				tarG.css("width", tarGW + "px");
				tarO.css("width", tarOW + "px");
			}
		}
	}
}

// 비교 기준 변경
function chgSizeTp(tp) {
	var tarBase = $("#gdSizeWrap");
	switch (tp) {
		case "card":
			tarBase.removeClass("mod_3d");
			tarBase.removeClass("sizeIs_paper");
			tarBase.addClass("mod_size");
			tarBase.addClass("sizeIs_card");
			tarBase.addClass("gdSizeOn");
			calcGDSize();
			break;
		case "a4":
			tarBase.removeClass("mod_3d");
			tarBase.removeClass("sizeIs_card");
			tarBase.addClass("mod_size");
			tarBase.addClass("sizeIs_paper");
			tarBase.addClass("gdSizeOn");
			calcGDSize();
			break;
	}
}

