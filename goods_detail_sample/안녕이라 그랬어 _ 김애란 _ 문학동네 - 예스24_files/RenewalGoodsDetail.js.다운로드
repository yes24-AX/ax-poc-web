// 상세개편 포멧 위치이동
function sclFormatXMove(range, nodeName, fIdx, dur) {
    var $rang = $(range); // 선택자
    var rangWidth = $rang.outerWidth(); // ul의 너비
    var totalWidth = 0; // 목표 li까지의 총 너비
    var targetLiCenter; // 목표 li의 중앙 위치

    // 목표 li 요소까지의 총 너비와 해당 li의 중앙 위치를 계산
    $rang.find(nodeName).each(function (i) {
        if (i < fIdx) {
            totalWidth += $(this).outerWidth(true);
        } else if (i === fIdx) {
            targetLiCenter = totalWidth + $(this).outerWidth(true) / 2;
            return false; // 반복 중단
        }
    });

    // ul의 중앙에 li를 위치시키기 위해 필요한 스크롤 위치 계산
    var scrollTo = targetLiCenter - rangWidth / 2;

    // 현재 진행 중인 애니메이션을 중단하고, 계산된 위치로 스크롤 애니메이션 시작
    $rang.stop().animate({
        scrollLeft: scrollTo
    }, dur); // 애니메이션 지속 시간 64ms
}

function movAspectRatio() {
    const gdBotSecElements = document.querySelectorAll('.gdBotSec');
    gdBotSecElements.forEach(section => {
        const iframes = section.querySelectorAll('iframe');
        iframes.forEach(iframe => {
            if (iframe.src.includes('youtube.com') && !iframe.src.includes('/shorts')) {
                const width = iframe.clientWidth;
                const height = width * (9 / 16); // 16:9 aspect ratio
                iframe.style.height = `${height}px`;
            }
        });
    });
}

function gdSclMove() {
    var scl = $(window).scrollTop();
    var tabMH = 60;
    var tabsH = 170;

    if (scl + gnbH > baseLine.offset().top) {
        //탭 고정
        yesWrap.addClass("fixedGdTab");
        if (scl > baseLine.offset().top + gnbH) {
            yesWrap.addClass("fixedGdToc");
        } else {
            yesWrap.removeClass("fixedGdToc");
        }

        //탭 온/OFF
        // Update tab links
        $tabSections.each(function (index) {
            var $section = $(this);
            var sectionTop = $section.offset().top;
            var sectionHeight = $section.outerHeight();

            if (scl + tabMH >= sectionTop && scl < sectionTop + sectionHeight) {
                var $currentTab = $tabs.eq(index);
                if (!$currentTab.hasClass('tabOn')) {
                    if (index != 0) {
                        yesWrap.addClass('isNotToc');
                    } else {
                        yesWrap.removeClass('isNotToc');
                    }
                    $tabs.removeClass('tabOn');
                    $currentTab.addClass('tabOn');
                }
            }
        });

        // 마지막 섹션을 지났을 때
        var lastSection = $tabSections.last();
        var lastSectionTop = lastSection.offset().top;
        var lastSectionHeight = lastSection.outerHeight();
        if (scl >= lastSectionTop + lastSectionHeight) {
            $tabs.removeClass('tabOn');
        }

        //화면 끝에 왔을 때 마지막 섹션을 넘어가지 않으면
        var winH = $(window).height();
        var footY = $("#footer").offset().top;
        var lastSectionIndex = lastSection.index() - 1; // lastSection의 인덱스를 계산
        if ((scl + winH > footY) && (scl < lastSectionTop)) {
            $tabs.removeClass('tabOn');
            $tabs.eq(lastSectionIndex).addClass('tabOn')
        }

        // Update toc links if in gdTabInfo section
        if ($tabSections.hasClass('gdTabInfo')) {
            $tocSections.each(function (index) {
                var $subSection = $(this);
                var subSectionTop = $subSection.offset().top;
                var subSectionHeight = $subSection.outerHeight();

                if (scl + tabsH >= subSectionTop && scl + tabsH < subSectionTop + subSectionHeight) {
                    var $currentToc = $tocs.eq(index).find('.lnk_toc');
                    if (!$currentToc.hasClass('tocOn')) {
                        $tocs.find('.lnk_toc').removeClass('tocOn');
                        $currentToc.addClass('tocOn');
                        if (gdTocSwiper != null) {
                            gdTocSwiper.slideTo(index, 96);
                            nowTocNo = index;
                        }
                    }
                }

                if ($tocs.length != $tabWrap.find('.toc .swiper-slide').length) {
                    $tocs = $tabWrap.find('.toc .swiper-slide'); // 다시 정의 하고
                    gdTocSwiper.update(); // 업데이트도 실행
                }
            });
        }
    } else {
        yesWrap.removeClass("fixedGdTab");
        yesWrap.removeClass("fixedGdToc");
        yesWrap.removeClass("isNotToc");
        $tabs.removeClass("tabOn");
        $tabs.eq(0).addClass("tabOn");
    }
}

