    ,
    //글자를 byte단위로 잘라준다.
    NSubstring: function (str, len) {
        var s = 0;
        for (var i = 0; i < str.length; i++) {
            s += (str.charCodeAt(i) > 128) ? 2 : 1;
            if (s > len) {
                return str.substring(0, i);
            }
        }
        return str;
    }
    ,
    // 저자정보를 파싱해주는 Function
    fnConvertAuthorInfo: function (strProductAuthor, res_GB, param) {
        var strResult = "";
        strResult = strProductAuthor;
        strResult = strResult.replace(/<b>/g, "");
        strResult = strResult.replace(/<\/b>/g, "");
        strResult = strResult.replace(/</g, "");
        strResult = strResult.replace(/>/g, "");

        var arrTemp = strResult.split('`');
        if (arrTemp.length >= 2) {
            if (arrTemp[0].length > 0 && arrTemp[1].length > 0) {
                strResult = arrTemp[0];
            } else {
                strResult = strResult.replace("`", "");
            }
        } else {
            strResult = arrTemp[0];
        }

        if (strResult != null) {
            strResult = strResult.cutByte2(120, '...');
        }

        return strResult;
    }
