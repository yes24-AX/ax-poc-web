        }

        AddSeriesSubscriptionV2(PushYn, SmsYn, EmailYn, userInfoChange, ChMonth, goodsNo, untNo, ActionType, CheckedSeriesNos, TICKETNOS, EVENTNM, EventMessage);
    }
}
