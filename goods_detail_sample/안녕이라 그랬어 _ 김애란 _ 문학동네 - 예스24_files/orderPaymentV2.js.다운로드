    //주문수량 증가/감소 세팅
    var setOrderCount = function (sender) {
        var obj = $(sender);
        let type = obj.data().type;
        var txtCount;
        var currentCount;

        if (type != undefined && type != "" && type != null) {
            txtCount = $("#optTotWrap").find(".choOpt").find("input[name=ORD_CNT]");
            currentCount = parseInt(txtCount.val());

            //0이 되는 경우 return
            if (type == 'minus' && currentCount == 1) {
                return;
            } else if (type == 'plus' && currentCount == 9999) {
                alert('수량은 최대 9999개까지 선택 가능합니다.');
                return;
            }

            switch (type) {
                case "plus":            //주문수량 증가
                    currentCount++;
                    break;
                case "minus":           //주문수량감소
                    if (currentCount > 1) {
                        currentCount--;
                    }
                    break;
                case "partBook":
                    var partBookOpiton = obj.val();
                    $("*[name='PARTBOOK_VALUE']").val(partBookOpiton); //파트북 옵션 재정의
                    var zipCd = $("#hdZipcd").val();
                    var seqNo = $("#hdZipseq").val();
                    var buMngNo = $("#hdbuMngNo").val();

                    setExpectedDeliveryDateV2(zipCd, seqNo, buMngNo);
                    if (partBookOpiton == 0) {
                        $("#partbook_price").css("display", "none");
                    } else {
                        //분철비 영역 텍스트
                        $("#partbook_price").css("display", "block");
                    }
                    break;
            }
        } else {
            checkMaxCount(sender);
            txtCount = obj;
            currentCount = parseInt(txtCount.val());
        }

        //주문수량 변경
        txtCount.val(currentCount);
        $("#total_order_count").text(currentCount);

        //최초가격
        var sale_price = parseInt(g_SalePrice.replaceAll(',', ''));
        sale_price = sale_price * currentCount;

        //최종분철비
        var partbook_price = $("#partbook_price").attr("data-partbook-price");
        var total_partbook_price = partbook_price * currentCount;

        $("#partbook_price").text("+ 분철비 " + total_partbook_price.formatMoney(0));
        $("#sale_price_area").text(sale_price.formatMoney(0));
        //최종가격(분철 옵션 선택 시, 분철 금액 포함)
        var total_price = $('input[name=buDivion]:checked').val() == '1' ? sale_price + (partbook_price * currentCount) : sale_price;
        total_price = (total_price).formatMoney(0);
        $("#total_order_price").text(total_price);
    }


