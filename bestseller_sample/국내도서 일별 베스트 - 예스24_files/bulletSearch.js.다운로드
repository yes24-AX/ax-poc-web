    // 우측 상품검색
    searchGoodsList: function (query, page) {
        var QDomainName = $("#qdomain").val();
        var domainName = BulletSearchRenewal.GetDomainNaem(QDomainName);

        if (domainName == "TICKET" || domainName == "BLOG_REVIEW" || domainName == "CHYES" || domainName == "STORE" || domainName == "USED_GOODS") {
            return false;
        }
        if (document.URL.toLowerCase().indexOf("www.yes24.com", 0) != -1) {
            $.getJSON("/Product/searchapi/bulletsearch/goods",
                { query: query, domain: domainName, page: page }
                , function (data) {
                    //$.ajaxSetup({ cache: false });
                    BulletSearchRenewal.BulletSearchGoodsCallBack(data);
                });
        } else {
            var webApiUrl = protocol + "//www.yes24.com/Product/searchapi/bulletsearch/goodsJsonp";
            $.ajax({
                url: webApiUrl 
                , dataType: 'jsonp'
                , data:
                    { query: query, domain: domainName, page: page }
                , success: function (data) {
                    BulletSearchRenewal.BulletSearchGoodsCallBack(data);
                }
            });
        }
    }
