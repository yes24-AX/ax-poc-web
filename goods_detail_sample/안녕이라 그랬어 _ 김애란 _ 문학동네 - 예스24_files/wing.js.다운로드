var wingTab = function (wTp) {
    
    var $doc = $("html, body");
    var gap = $("#memInfo .memInfoTop").outerHeight() + parseInt($("#memInfo .memInfoTop").css("top"), 10) + 10;

    $("#tabWing li").removeClass("on");
    $("#tab_" + wTp).addClass("on");

    switch (wTp) {
        case "cateN":
            $("#favoGrp").hide();
            $("#cateNGrp").show();
            $("#yesFamily").show();
            current_tab = 0;
            break;
        case "cateF":
            $("#favoGrp").show();
            $("#cateNGrp").hide();
            $("#yesFamily").hide();
            current_tab = 1;
            break;
    }

    $doc.stop().animate({ scrollTop: $("#cateWing").offset().top - gap }, 500, "easeInOutQuart");
}

