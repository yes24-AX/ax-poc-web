            multi_option_array_item.seq_no = goods_option.seq_no;
            multi_option_array_item.count = 1;
            multi_option_array_item.opt_name = current_option_text; // 선택 옵션명.
            multi_option_array.push(multi_option_array_item);

            addSelectedOptionLayer(goods_option, current_option_text, "option_list_area");
            addSelectedOptionLayer(goods_option, current_option_text, "gd_selGrpWrap");

