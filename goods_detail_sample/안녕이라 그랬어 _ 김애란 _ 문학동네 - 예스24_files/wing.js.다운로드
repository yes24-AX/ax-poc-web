function openWingMenu(back) {
    if (APP_GB == 'YES24' && IS_NATIVE_APPS) {
        if (IS_UPDATE_APPS == 'Y') {
            var param = USERNO != '' ? '&callfunction=greetingMsg();getFavoriteServiceArea();' : '';
            if (IS_ANDROID) {
              location.href = 'intent://openWingMenu?back=' + back + param+'#Intent;scheme=YES24;package=com.yes24.commerce;end';
            }
            else if (IS_IOS) {
                location.href = 'YES24://openWingMenu?back=' + back + param;
            }
        } else {
            var storeUrl = IS_IOS ? 'https://apps.apple.com/kr/app/yes24/id360051536' : 'https://play.google.com/store/apps/details?id=com.yes24.commerce&feature=search_result#?t=W251bGwsMSwyLDEsImNvbS55ZXMyNC5jb21tZXJjZSJd';
            alert('YES24 APP을 최신 버전으로 업데이트해 주세요.');
            location.href = storeUrl;
        }
    }
    else {
      // 웹에서 윙메뉴가 닫힐 때 이동할 이전 페이지 셋팅
      // 즐겨찾는 서비스 편집 페이지는 예외처리
      var current_page = location.href;
      if (current_page.toLowerCase().indexOf("editfavoriteservice") < 0){
          setCookie('wingPreviousPage', current_page, 7);
      }

      location.href = MOBILE_URL + "/Home/Wing";
    }
}

function closeWingMenu() {
    if (APP_GB == 'YES24' && IS_UPDATE_APPS == 'Y') {
        if (IS_ANDROID) {
          location.href = 'intent://closeWingMenu#Intent;scheme=YES24;package=com.yes24.commerce;end';
        }
        else if (IS_IOS) {
            location.href = 'YES24://closeWingMenu';
        }
        //$('#wingLoadingdiv').show(); ↓ 로딩 대신 빈 화면으로 대체
        $('#yesWing').remove();
    }
    else {
      if (document.referrer.toLowerCase().indexOf('home/editfavoriteservice') > -1 && window.history.length > 3) {
          history.go(-3);
      } else {
          if (window.history.length > 1){
              history.go(-1);
          } else {
              location.href = MOBILE_URL;
          }
      }
    }
    window.setTimeout(function () {
        sclTop($("#yesWing"), null, 0);
    }, 150);
}

