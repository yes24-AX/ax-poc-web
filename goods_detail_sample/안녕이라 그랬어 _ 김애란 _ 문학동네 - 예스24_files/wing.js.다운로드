var setAlarmCnt = function (cnt) {
    if (typeof cnt !== 'undefined') {
        if (cnt > 0) {
            if (cnt > 99) {
                cnt = 99;
            }
            var alarm_cnt_html = String.Format('<em id="alarm_cnt" class="num">{0}</em>', cnt);
            $("#alarm_area").append(alarm_cnt_html);

            if (cnt > 0) {
                $("#alarm_area").addClass("alarmOn");
            }
            
        } else {
            $("#alarm_area").removeClass("alarmOn");
            $("#alarm_cnt.num").remove();
        }
    }
}

