var gdImgAreaW = 0; //이미지 영역 너비
var gdImgSideW = 0; //책등 높이
var isGdFirst = true;

function gd3DApply(areaW) {
	var target = $("#gdImgWrap:not(.tp_class24):not(.tp_other) .gdItemUnit");

	//너비 변화 있을 때 3D실행
	if ((target.hasClass("spineOn")) && (gdImgAreaW != areaW)) {
		var rBookSideL; //책등 왼쪽
		var rBookSideR; //책등 오른쪽
		var rBookBack; //뒷표지
		var rBookSideImg;
		var rSideW = 0;
		var rBookLen = target.length;

		for (var i = 0; i < rBookLen; i++) {
			var rBook = target.eq(i);

			rBookSideL = rBook.find(".sideL");
			rBookSideR = rBook.find(".sideR");
			rBookSideImg = rBook.find(".sideL img");
			rBookBack = rBook.find(".back");
			rSideW = gdImgSideW = rBookSideImg.width();

			rBookSideL.css({ "transform": "rotate3d(0,1,0,-90deg) translate3d(-50%, 0, 0)", "left": Math.trunc((-rSideW / 2)) + "px", "width": Math.trunc(rSideW) + "px" });
			rBookSideR.css({ "transform": "rotate3d(0,1,0,90deg) translate3d(50%, 0, 0)", "right": Math.trunc((-rSideW / 2)) + "px", "width": Math.trunc(rSideW) + "px" });
			rBookBack.css({ "transform": "rotate3d(0,1,0,-180deg) translate3d(0, 0, " + Math.trunc(rSideW) + "px)" });

			rBook.addClass("loadOn");//배치 시키고 사이드 이미지 보이게 하기 위한 방어코드
		}
		gdImgAreaW = areaW; //3D적용 후 기준 너비 갱신
		gd3DCenter(areaW); //3D이미지 중앙정렬
	}
}

// 중앙 체크
function gd3DCenter(areaW) {
	var target = $("#gdImgWrap:not(.tp_class24):not(.tp_other) .gdItemUnit");
	var winW = areaW;
	var leftM, rightM, tarM;
	var rBookLen = target.length;

	//초기화
	if (!isGdFirst) {
		target.removeClass("viewSide");
		target.removeClass("viewFront");
		target.removeClass("viewBack");
		target.find(".img_item").attr("style", "");
		nowGdAngle = 0;
	}

	target.addClass("chkCenter");

	for (var i = 0; i < rBookLen; i++) {
		var rBook = target.eq(i);

		if (target.hasClass("spineLft")) {
			leftM = Math.floor(target.find(".sideL").offset().left);
			rightM = Math.floor(winW - target.find(".img_grp .posTick").offset().left);
			tarM = (rightM - leftM);
			target.find(".img_item").css("margin-left", Math.floor(tarM) + "px");
		} else {
			leftM = Math.floor(target.find(".img_grp").offset().left);
			rightM = Math.floor(winW - target.find(".sideR .posTick").offset().left);
			tarM = (leftM - rightM);
			target.find(".img_item").css("margin-left", Math.floor(tarM) + "px");
		}
	}
	target.removeClass("chkCenter"); // 중앙정렬 계산 체크 class삭제

	if (isGdFirst) {
		target.addClass("noDelay");

		setTimeout(function () {
			target.removeClass("noDelay");
			target.addClass("initTurn");
		}, 500);
		setTimeout(function () {
			target.removeClass("initTurn");
			target.addClass("readyOn");
		}, 2400);
	}

	isGdFirst = false;
}

// 상품 이미지 각도
var nowGdAngle = 0;

// 상품 이미지 회전
function gdChgAngle(dir) {
	var target = $("#gdImgWrap:not(.tp_class24):not(.tp_other) .gdItemUnit");

	if (!(target.hasClass("spineOn") && target.hasClass("readyOn"))) return;

	var nowClass = target.hasClass("viewSide") ? "viewSide" :
		target.hasClass("viewBack") ? "viewBack" : "viewFront";

	var tarform = target.find(".img_item").css("transform");
	var tar3d = (tarform.match(/translate3d\([^)]+\)/) || ['translate3d(0, 0, 0)'])[0];
	var spineLft = target.hasClass("spineLft");
	var angleMap = {
		"viewFront": {
			rgt: { next: spineLft ? "viewBack" : "viewSide", angle: spineLft ? -180 : -40 },
			lft: { next: spineLft ? "viewSide" : "viewBack", angle: spineLft ? 40 : 180 }
		},
		"viewSide": {
			rgt: { next: spineLft ? "viewFront" : "viewBack", angle: spineLft ? -40 : -140 },
			lft: { next: spineLft ? "viewBack" : "viewFront", angle: spineLft ? 140 : 40 }
		},
		"viewBack": {
			rgt: { next: spineLft ? "viewSide" : "viewFront", angle: spineLft ? -140 : -180 },
			lft: { next: spineLft ? "viewFront" : "viewSide", angle: spineLft ? 180 : 140 }
		}
	};

	var direction = angleMap[nowClass][dir];
	target.removeClass(nowClass).addClass(direction.next);
	nowGdAngle += direction.angle;

	// viewBack 인 경우에만 translate3d 값 조정
	if (direction.next === "viewBack") {
		tar3d = `translate3d(0, 0, ${gdImgSideW}px)`;
	}

	target.find(".img_item").css('transform', `rotate3d(0, 1, 0, ${nowGdAngle}deg) ${tar3d}`);
}


