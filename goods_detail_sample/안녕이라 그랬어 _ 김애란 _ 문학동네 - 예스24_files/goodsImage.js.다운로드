function setGoodsBg(img) {
	try {
		var vibrant = new Vibrant(img);
		swatches = vibrant.swatches();

		if (!swatches || Object.keys(swatches).length === 0) {
			if (retryCount < maxRetries) {
				retryCount++;
				console.log("Retrying to fetch swatches, attempt #" + retryCount);
				setTimeout(function () {
					setGoodsBg(img);
				}, 300); // Retry after 1 second
			} else {
				console.log("Failed to fetch swatches after " + maxRetries + " attempts");
			}
			return;
		}

		var bgSwatch = swatches["DarkVibrant"] || swatches["Vibrant"] || swatches["DarkMuted"] || swatches["Muted"];

		// Extract the colors
		var bgColor = bgSwatch ? bgSwatch.getHex() : "#333333";

		// Determine if color is light or dark
		if (bgColor) {
			var rgb = bgSwatch ? bgSwatch.getRgb() : [51, 51, 51];
			var brightness = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]);
			var adjustedColor;

			adjustedColor = tinycolor(bgColor).brighten(25).saturate(25);

			$("#gdImgWrap").css("background", bgColor);

			// Get the adjusted color as RGB
			var adjustedRgb = adjustedColor.toRgb();
			var r = adjustedRgb.r;
			var g = adjustedRgb.g;
			var b = adjustedRgb.b;

			// Set gradient background from top to bottom
			var gradient = `linear-gradient(0deg, rgba(${r},${g},${b},0.01) 0%, rgba(${r},${g},${b},0.4) 40%, rgba(${r},${g},${b},1) 100%)`;
			$("#gdImgWrap .gdImgDeco").css("background", gradient);
		}
	} catch (e) {
		console.error("Error processing image with Vibrant:", e);
	}
}