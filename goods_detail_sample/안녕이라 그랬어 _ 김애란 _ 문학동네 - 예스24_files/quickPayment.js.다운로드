                                    <strong class="txt_num"><em class="yes_m">${optSalePrice}</em>원</strong>
                                    <span class="txt_cnt">${value.count.formatMoney(0)}개</span>
                                 </span>
                             </div>`;
        });
    } else {
        const optMsg = $("*[name='ORD_GOODS_OPT_MSG']").val();
        const orderCnt = $("#total_order_count").text().formatMoney(0);
        const orderPrice = $("#total_order_price").text();
        addOptionTag += `<div class="info_row info_bill">
                            <span class="msgSet">${optMsg}</span>
                                <span class="priceSet">
                                <strong class="txt_num"><em class="yes_m">${orderPrice}</em>원</strong>
                                <span class="txt_cnt">${orderCnt.formatMoney(0)}개</span>
                            </span>
                        </div>`;
    }

    return addOptionTag;
}


//결제 실행 화면 이동
function postToQuickPayment(validate) {
    if (!validate.IsSuccess) {
        alert(validate.ResultMessage)
        sendQuickPaymentLog(validate);
    } else {
        const transactionId = validate.ResultContents.TransactionId;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `${SSL_API_URL}/QuickPayment/Payment`;

        const inputTransactionId = document.createElement('input');
        inputTransactionId.type = 'hidden';
        inputTransactionId.name = 'TransactionId';
        inputTransactionId.value = transactionId;

        const inputReturnUrl = document.createElement('input');
        inputReturnUrl.type = 'hidden';
        inputReturnUrl.name = 'ReturnUrl';
        inputReturnUrl.value = window.location.href;

        form.appendChild(inputTransactionId);
        form.appendChild(inputReturnUrl);

        document.body.appendChild(form);
        form.submit();
    }
}
