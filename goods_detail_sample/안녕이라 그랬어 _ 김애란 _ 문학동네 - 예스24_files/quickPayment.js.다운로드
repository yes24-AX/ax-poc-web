//빠른결제 최종 결제 금액
let totalPrice = 0;
let delvFee = 0;
//빠른결제 주소 정보
let quickPaymentAddress = {};
//레이어 HTML생성
function setQuickPaymentDetail(data) {
    let quantity = Number($("*[name='ORD_CNT']").val() || setTotalCountForQuickPaymentOptionGoods());
    let optionMessage = $("*[name='ORD_GOODS_OPT_MSG']").val();

    const basePrice = parseInt(g_SalePrice, 10) * quantity;
    //옵션 상품인 경우 옵션가 합산
    const optionTotalPrice =
        (typeof multi_option_array === 'object' && multi_option_array !== null)
            ? Object.values(multi_option_array).reduce((sum, option) => sum + (option.opt_salepr * option.count), 0) : 0;
    //기본 가격과 옵션 가격을 합산하여 총 가격 계산
    totalPrice = basePrice + optionTotalPrice;

    //배송 예정일 API 호출
    if (($("#hdZipcd").val() != $("#lastDelvZipcd").val()) || (delvText == "" || typeof multi_option_array === 'object' || (g_GoodsStateGb == "02" && parseInt(quantity) > 1)) && g_GoodsStateGb != "01") {
        let items = {
            goodsNos: parseInt(g_GoodsNo),
            goodsSeq: typeof multi_option_array === "undefined" ? 1 : multi_option_array[0].goods_seq,
            goodsCnt: typeof multi_option_array === "undefined" ? parseInt(quantity) : parseInt(multi_option_array[0].count),
            zipCd: $("#lastDelvZipcd").val(),
            zipSeq: $("#lastZipseq").val(),
            buMngNo: $("#lastBuMngNo").val(),
            partBookSeq: 0
        };

        $.ajax({
            dataType: 'json',
            data: items,
            url: SSL_API_URL + '/DelvTraceInfo/GetDelvDateV2List',
            type: 'POST',
            xhrFields: { withCredentials: true },
            success: function (result) {
                if (result.length > 0 && result[0].IsSuccess) {
                    const delvItem = result[0];
                    delvText = `${delvItem.deliBoxRowText2} <strong>${delvItem.deliBoxRowText3}</strong> ${delvItem.deliBoxRowText4}`;
                }
                renderQuickPaymentSection(data, quantity, delvText);
            }
        });
    } else {
        var $desEl = $(".deliTxtRow .deli_des");
        var $dateEl = $(".deliTxtRow .deli_date");
        var hasDes = $desEl.length > 0;
        var hasDate = $dateEl.length > 0;
        var delvText = "";

        if (hasDes) delvText += $desEl.text().trim();
        if (hasDate) {
            var $strong = $(".deliTxtRow .deli_date strong");
            var dateText = ($strong.length === 0)
                ? $(".deliTxtRow .deli_date").clone().find("em").remove().end().text().trim()
                : $strong.prop("outerHTML") + $strong[0].nextSibling.nodeValue;
            delvText += ` ${dateText}`;
        }

        if (g_GoodsStateGb == "01") {
            delvText = $("#preOrderDelvArea").clone().find("em").remove().end().text().trim();
        }

        renderQuickPaymentSection(data, quantity, delvText);
    }

}

function renderQuickPaymentSection(data, quantity, delvText) {
    $("#sectionQuickPayment").remove();
    const g_GoodsGrdName = $("#goodsBenefit").text();

    const quickPaymentHtml =
        data.replaceAll('{RES_KEY_NM}', g_ResourceKeyName)
            .replaceAll('{GOODS_NM}', g_GoodsName)
            .replaceAll('{TOT_PRICE}', totalPrice.formatMoney(0))
            .replaceAll('{QUANTITY}', quantity.formatMoney(0))
            .replaceAll('{DISC_RT}', (quantity * parseInt(g_DiscRate)).formatMoney(0))
            .replaceAll('{DELV_TEXT}', delvText)
            .replaceAll('{GRD_GOODS_NM}', g_GoodsGrdName);

    $("#barBtnWrap").before(quickPaymentHtml);

    if (!g_GoodsGrdName) $("#quickPaymentBenefit").remove();

    delvFee = $("#quickDelvFee").text() == '무료' ? 0 : parseInt($("#quickDelvFee").text().replace(/[^0-9]/g, ''));

    $('#sectionQuickPayment *').contents().filter(function () {
        return this.nodeType === 3 && this.nodeValue.includes('{RESULT_PRICE}');
    }).each(function () {
        this.nodeValue = this.nodeValue.replace(/{RESULT_PRICE}/g, (totalPrice + delvFee).formatMoney(0));
    });

    if (g_DeductionYn != 'Y') {
        $("#deductionYn").remove();
    }

    const optionMessage = $("*[name='ORD_GOODS_OPT_MSG']").val();
    if (typeof multi_option_array === "undefined" && typeof optionMessage === "undefined") {
        $("#sectionGoodsOption").remove();
    } else {
        let optionHtml = getQuickPaymentOptionArea();
        $("#sectionGoodsOption").html(optionHtml).show();
    }
}


