    //주소 선택 팝업 오픈
    function showMyAddress(platform, page, callback) {
        if (!checkLogin()) {
            alert("주소록은 로그인 후 이용할 수 있습니다.");
            return;
        }
        if (typeof callback != 'undefined') {
            myAddressCallbackFunc = callback;
        }
        currentPlatform = platform;
        parentPage = page;
        const url = `${ADDRESS_API_URL}/Module/MyAddress?platform=${platform}&page=${page}`;
        if (platform == "m") {
            fetch(url, {
                method: 'GET', mode: 'cors', credentials: 'include'
            }).then(function (response) {
                return response.text();
            }).then(function (data) {
                const elements = document.querySelectorAll("#myAddress");
                if (elements.length > 0) {
                    elements[0].remove();
                }

                $('#yesWrap').append(data);
                pageNo++;
                disableBodyScroll();
                init();
            }).catch(function (error) { });
        }
        else if (platform == "p") {

        }
    }

    //주소록 더보기 HTML 생성
    function appendMyAddressHtml(data) {
        let resultHtml = '';
        for (let i = 0; i < data.length; i++) {
            let templateHtml = document.getElementById('templateMyAddress').innerHTML;
            const result = `{ZIP_CD: '${data[i].Zip}',ZIP_SEQ: '${data[i].ZipSeq}', ADDR1: '${data[i].Addr1}',ADDR2: '${data[i].Addr2}',ADDR3: '${data[i].Addr3}',ADDR4: '${data[i].Addr4}',BU_MNG_NO: '${data[i].BU_MNG_NO}',NAT_GB: '${data[i].NAT_GB}',TEL_NO: '${data[i].TelNo}', MOB_NO: '${data[i].MobNo}',ADDR_NM: '${data[i].ADDR_NM}'}`;

            templateHtml = templateHtml
                .replaceAll('{SEQ}', data[i].Seq)
                .replaceAll('{ADDR_NM}', data[i].ADDR_NM)
                .replaceAll('{ADDR_NICK}', data[i].ADDR_NICK)
                .replaceAll('{ADDRESS_STYLE}', data[i].NAT_GB == '101' ? '' : 'display:none;')
                .replaceAll('{GLOBAL_STYLE}', data[i].NAT_GB == '101' ? 'display:none;' : '')
                .replaceAll('{ZIP_CODE}', data[i].Zip !== '' ? `(${data[i].Zip}) ` : ``)
                .replaceAll('{ADDRESS_TEXT}', `${data[i].Addr3}, ${data[i].Addr2} (${data[i].Addr4})`)
                .replaceAll('{ADDRESS_TEXT2}', `${data[i].Addr1} ${data[i].Addr2}`)
                .replaceAll('{MOB_NO}', data[i].MobNo)
                .replaceAll('{TELNO_STYLE}', data[i].TelNo == '' ? 'display:none;' : '')
                .replaceAll('{TEL_NO}', data[i].TelNo == '' ? '' : data[i].TelNo)
                .replaceAll('{MY_ADDRESS_JSON}', result);
            resultHtml += templateHtml;
        }
        const moreButtonArea = document.getElementById('addressMoreButtonArea');
        if (moreButtonArea) {
            moreButtonArea.insertAdjacentHTML('beforebegin', resultHtml);
        } else {
            document.getElementById('myAddrList').insertAdjacentHTML('beforeend', resultHtml);
        }
    }

    //주소록 더보기
    function moreMyAddress(platform, page, totalCount) {
        if (!checkLogin()) {
            alert("주소록은 로그인 후 이용할 수 있습니다.");
            return;
        }
        const url = `${ADDRESS_API_URL}/Module/MoreMyAddress?platform=${platform}&page=${page}&pageNo=${pageNo}`;
        if (platform == "m") {
            fetch(url, {
                method: 'GET', mode: 'cors', credentials: 'include'
            }).then(function (response) {
                return response.json();
            }).then(function (data) {
                appendMyAddressHtml(data);
                pageNo++;
                const displayCount = document.querySelectorAll('#myAddrList .addrBox').length;
                if (totalCount === displayCount) {
                    document.getElementById('addressMoreButton').remove();
                }
            }).catch(function (error) { });
        }
        else if (platform == "p") {

        }
    }

    //주소록 등록/수정 팝업 오픈
    function showMofifyAddress(platform, page, type, addrSeq, callback) {
        if (!isAjaxDoing && $("#modifyAddress").length == 0) {
            if (!checkLogin()) {
                alert("주소록은 로그인 후 이용할 수 있습니다.");
                return;
            }
            if (typeof callback != 'undefined') {
                modifyAddressCallbackFunc = callback;
            }
            const url = `${ADDRESS_API_URL}/Module/AddModifyAddress?platform=${platform}&page=${page}&type=${type}&addrSeq=${addrSeq}`;
            if (platform == "m") {
                isAjaxDoing = true;
                fetch(url, {
                    method: 'GET', mode: 'cors', credentials: 'include'
                }).then(function (response) {
                    return response.text();
                }).then(function (data) {
                    $('#yesWrap').append(data);
                    disableBodyScroll();
                    init();
                }).catch(function (error) {
                }).finally(function () {
                    isAjaxDoing = false;
                });
            }
            else if (platform == "p") {

            }
        }
    }

    //초기화 및 이벤트 설정
    function init() {
        document.querySelector("#txt_search_word").addEventListener("keydown", function (e) {
            if (isEnteryKey(e)) {
                if (validateSearchword()) {
                    resetAndSearchAddress();
                }
            }
        });

        document.querySelector("#resultArea").addEventListener('scroll', function () {
            const scrollTop = this.scrollTop;
            const scrollHeight = this.scrollHeight;
            const offsetHeight = this.offsetHeight;

            // 스크롤이 끝에 도달했을 때
            if (scrollTop + offsetHeight >= scrollHeight) {
                searchMoreAddress();
            }
        });
        document.querySelector("#txt_search_word").focus();
    }

    function chkNatVal(element) {
        //키보드 상의 특수문자와 알파벳, 숫자만 허용
        element.value = element.value.replace(/[^a-zA-Z0-9 !@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+/g, '');
    }

    function openThisUrl(url) {
        var strInfo = '';
        var iosUrlScheme = '';
        var andUrlScheme = '';

        strInfo = '?url=' + escape(url);

        iosUrlScheme = 'YES24://OPENURL' + strInfo;
        andUrlScheme = 'intent://OPENURL' + strInfo + '#Intent;scheme=YES24;package=com.yes24.commerce;end';

        if (APP_GB == 'YES24') {
            if (IS_ANDROID) {
                location.href = andUrlScheme;
            } else if (IS_IOS) {
                location.href = iosUrlScheme;
            }
        } else {
            location.href = IS_ANDROID ? andUrlScheme : 'https://yes24app.page.link/MAIN';
        }
    }

