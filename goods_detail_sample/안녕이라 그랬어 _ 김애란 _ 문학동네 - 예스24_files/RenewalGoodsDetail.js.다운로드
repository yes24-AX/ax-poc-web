let currentAudio = null;
function discPlay(element) {
    var parentLi = element.closest('li');

    var audio = parentLi.querySelector('audio');
    var disc = parentLi.querySelector('.discWrap');
    var bar = parentLi.querySelector('.bar');

    if (currentAudio && currentAudio !== audio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;  // Reset playback position
        var otherLi = currentAudio.closest('li');
        var otherDisc = otherLi.querySelector('.discWrap');
        var otherBar = otherLi.querySelector('.bar');
        if (otherDisc) {
            otherDisc.classList.remove('isPlaying');
            otherDisc.classList.remove('isPause');
        }
        if (otherBar) {
            otherBar.style.width = '0'; // Reset progress bar
        }
        currentAudio = null; // Reset current audio
    }

    if (audio) {
        if (audio.paused) {
            audio.play();
            disc.classList.add('isPlaying');
            disc.classList.remove('isPause'); // Ensure isPause is removed
            currentAudio = audio; // Update the current audio
        } else {
            audio.pause();
            disc.classList.add('isPause');
        }

        audio.ontimeupdate = function () {
            var progress = (audio.currentTime / audio.duration) * 100;
            bar.style.width = progress + '%';
        };

        audio.onended = function () {
            bar.style.width = '0';
            disc.classList.remove('isPlaying');
            disc.classList.remove('isPause');
            currentAudio = null; // Reset current audio
        };
    }
}

