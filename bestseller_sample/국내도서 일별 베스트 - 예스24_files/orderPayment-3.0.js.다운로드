    var orderPaymentProcess = function (processParam, isCheckGoods, isCart, isOrder, isMyList, isDigital, isDfinery) {
        if (isDigital == undefined || isDigital == null) isDigital = false;
        if (isDfinery == undefined || isDfinery == null) isDfinery = false;

        var arrGoods = processParam.arrGoods;
        var categoryNumber = processParam.categoryNumber;
        var layerId = processParam.layerId;
        var codeName = processParam.codeName;
        var code = processParam.code;
        var type = processParam.type;
        var goodsGb = processParam.goodsGb;
        var popupPosParam = processParam.popupPosParam;
        var pageType = popupPosParam.pageType;
        var isDetailPaymentTarget = isDetailPageType(pageType) && hasDetailPaymentButtons() && (isCart || (isOrder && !isDigital));

        var json = returnValidArrGoods(arrGoods, pageType, isCheckGoods, isCart, isOrder, isMyList);

        if (_isDebug) {
            console.log("processParam");
            console.log(processParam);
            console.log("isCheckGoods: " + isCheckGoods);
            console.log("isCart: " + isCart);
            console.log("isOrder: " + isOrder);
            console.log("isMyList: " + isMyList);
            console.log("isDigital: " + isDigital);
            console.log("isDfinery: " + isDfinery);
        }

        if (json.result || json.errorCode == -9) {
            if (isDetailPaymentTarget && !lockDetailPaymentButtons()) {
                document.activeElement.blur();
                return false;
            }

            if (isCart) {
                var cartPromise = cartProcess(arrGoods, isCheckGoods, categoryNumber, layerId, codeName, code, type, goodsGb, isDfinery, popupPosParam);

                if (isDetailPaymentTarget && cartPromise && typeof cartPromise.finally === "function") {
                    cartPromise.finally(function () {
                        unlockDetailPaymentButtons();
                    });
                }
            }

            if (isOrder) {
                if (isDigital) {
                    orderOnclickProcess(arrGoods, isCheckGoods, categoryNumber, layerId, codeName, code, type, goodsGb, isDfinery);
                } else {
                    try {
                        orderProcess(arrGoods, isCheckGoods, categoryNumber, layerId, codeName, code, type, goodsGb, isDfinery, isDetailPaymentTarget ? unlockDetailPaymentButtons : null);
                    } catch (error) {
                        if (isDetailPaymentTarget) {
                            unlockDetailPaymentButtons();
                        }

                        throw error;
                    }
                }
            }

            if (isMyList) {
                myListProcess(arrGoods, isCheckGoods, categoryNumber, layerId, codeName, code, type, goodsGb, isDfinery);
            }
        }
        else {
            if (isDetailPaymentTarget) {
                unlockDetailPaymentButtons();
            }

            jsonProcess(json);
        }

        document.activeElement.blur();
    }

