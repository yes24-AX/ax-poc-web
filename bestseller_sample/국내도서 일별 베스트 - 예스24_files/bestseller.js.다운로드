            dictParam.saleMonth = val;
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize == "" || pageSize == null ? 24 : pageSize;
            break;
        case "weekNo":
            dictParam.saleYear = $("#scope_year option:selected").val();
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize == "" || pageSize == null ? 24 : pageSize;
            break;
    }

    var bestTypeUrl = "";

    switch (bestType) {
        case "YES24_BESTSELLER":
