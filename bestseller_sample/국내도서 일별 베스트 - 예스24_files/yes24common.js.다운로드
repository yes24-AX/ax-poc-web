                goto_login(HTTP_URL + "/Order/FTOrderReg04.aspx", "OrdGoodsNoH=" + data.goods_no + "`ActionType=DIRECT`OrdGoodsSeqH=" + data.goods_seq + "`LoginYnH=Y`DispNoH=" + dispNo + "`OCNT=" + ordCnt);
