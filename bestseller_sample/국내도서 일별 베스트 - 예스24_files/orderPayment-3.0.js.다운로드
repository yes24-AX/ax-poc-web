    /**
     *  구글 GA4 GTM(태그매니저) 카트에 넣기(장바구니 추가) 전송.
     *  
     *  window.dataLyer에 전송할 데이터 push.
     *  
     *  @param {Object[]} arrGoods  카트에 넣기한 상품 배열.
     */
    var sendGoogleAnalyticsAddCartLog = function (arrGoods) {

        try {

            if (arrGoods.length < 1) {
                throw new Error('카트 추가 항목이 없습니다.');
            }

            var itemList = [];
            var addToCartTotalPrice = 0;

            arrGoods.forEach(function (goods, i) {
                var _price = Number(parseFloat(goods.salePrice).toFixed(2));
                var _discount = Number(parseFloat(goods.discountShopPrice).toFixed(2));
                var _item_name = htmlEntityDetail.decodeHTMLEntity(goods.goods_name.toString().trim());

                var item = {
                    item_id: goods.goods_no.toString(),
                    item_name: _item_name,
                    item_category: goods.goodsSortNm.toString(),
                    price: _price, // 판매가
                    discount: _discount, // 할인 금액
                    quantity: goods.goods_cnt,
                    item_sort_no: goods.goodsSortNo.toString(), // 관리 분류
                    item_sort_nm: goods.goodsSortNm.toString(), // 관리 분류명
                };

                // 옵션 상품일 때
                if (goods.hasOwnProperty('goods_opt_name')) {
                    if (goods.goods_opt_name != null && goods.goods_opt_name != '') {
                        item.item_variant = htmlEntityDetail.decodeHTMLEntity(goods.goods_opt_name.toString().trim());
                    }
                }

                addToCartTotalPrice += (item.price * item.quantity);

                itemList.push(item);
            });

            if (itemList.length > 0 && addToCartTotalPrice > 0) {

                addToCartTotalPrice = Number(parseFloat(addToCartTotalPrice).toFixed(2));

                var ecommerceData = {
                    currency: "KRW",
                    value: addToCartTotalPrice,
                    items: itemList
                }


                dataLayer.push({ ecommerce: null });  // Clear the previous ecommerce object.
                dataLayer.push({
                    event: "add_to_cart",
                    ecommerce: ecommerceData
                });

