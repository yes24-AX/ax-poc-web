/**
 * eBook / 오디오북 미리보기 점검 제어 함수
 * - 점검 시간일 경우 alert 노출 후 클릭 동작 차단
 * - 점검 시간이 아니면 기존 동작 허용
 * @returns {boolean} true: 정상 진행 / false: 동작 차단
 */
function PreviewMaintenanceGuard() {

    // 점검 시간 설정 (월: 0부터 시작)
    var MaintenanceStart = new Date(2026, 0, 28, 18, 0);   // 1/28 18:00
    var MaintenanceEnd   = new Date(2026, 0, 28, 20, 30);  // 1/28 20:30

    // 현재 시간
    var Now = new Date();

    // 점검 시간 여부 판단
    if (Now >= MaintenanceStart && Now <= MaintenanceEnd) {

        alert(
            "이용에 불편을 드려 죄송합니다.\n\n" +
            "현재 네트워크 점검 작업으로 인해\n" +
            "미리보기/미리듣기 서비스가 일시 중단되었습니다.\n\n" +
            "점검 시간: 1/28(수) 18:00 ~ 20:30\n" +
            "(약 2시간 30분 소요 예정)"
        );

        return false; // href, 기존 onclick 모두 차단
    }

    return true; // 정상 동작
}

/**
 * 오디오북 미리듣기 팝업 오픈 (화면 중앙)
 */
function PreviewAudioBook(goodsNo) {

    var popupWidth = 300;
    var popupHeight = 400;

    // 현재 브라우저 기준 위치 계산
    var dualScreenLeft = window.screenLeft !== undefined ? window.screenLeft : screen.left;
    var dualScreenTop = window.screenTop !== undefined ? window.screenTop : screen.top;

    var windowWidth = window.innerWidth
        ? window.innerWidth
        : document.documentElement.clientWidth
            ? document.documentElement.clientWidth
            : screen.width;

    var windowHeight = window.innerHeight
        ? window.innerHeight
        : document.documentElement.clientHeight
            ? document.documentElement.clientHeight
            : screen.height;

    // 중앙 좌표 계산
    var left = ((windowWidth - popupWidth) / 2) + dualScreenLeft;
    var top = ((windowHeight - popupHeight) / 2) + dualScreenTop;

    window.open(
        FRONT_API_URL + '/Module/Preview?goodsNo=' + goodsNo,
        '_blank',
        'width=' + popupWidth +
        ',height=' + popupHeight +
        ',top=' + top +
        ',left=' + left +
        ',scrollbars=yes'
    );

    return false;
}


