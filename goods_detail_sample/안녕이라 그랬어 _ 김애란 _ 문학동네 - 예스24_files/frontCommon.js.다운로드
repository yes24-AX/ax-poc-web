/**
 * 프론트 API 장바구니 관련 모듈
 */
var frontApiCart = (function () {
    var _frontApiUrl = (function () {
        var url = "";

        if (typeof YesData !== "undefined"
            && YesData
            && typeof YesData.FRONT_API_URL === "function") {
            url = YesData.FRONT_API_URL();

            if (url) {
                return url;
            }
        }

        if (typeof FRONT_API_URL !== "undefined" && FRONT_API_URL) {
            return FRONT_API_URL;
        }

        return "https://frontapi.yes24.com";
    })();

    var API_URL = _frontApiUrl + '/api/goods/cart';
    var DEFAULT_SUCCESS_MESSAGE = '카트담기에 성공하였습니다.';
    var DEFAULT_ERROR_MESSAGE = '카트담기에 실패하였습니다.';
    var INVALID_CART_ITEMS_MESSAGE = '상품 정보가 올바르지 않습니다.';
    var INVALID_GOODS_NO_MESSAGE = '상품번호가 올바르지 않습니다.';
    var TIMEOUT_ERROR_MESSAGE = '요청 시간이 초과되었습니다.';
    var REQUEST_TIMEOUT = 10000;

    async function addCart(cartItems) {
        var items = normalizeCartItems(cartItems);
        var payload = [];
        var controller = new AbortController();
        var timeoutId = null;
        var response;
        var result;
        var checkResult;
        var cartResponse;
        var i;
        var item;
        var qty;

        if (!items.length) {
            throw createError(INVALID_CART_ITEMS_MESSAGE, { cartItems: cartItems });
        }

        for (i = 0; i < items.length; i++) {
            item = items[i];

            if (!item || item.goodsNo == null || item.goodsNo === '') {
                throw createError(INVALID_GOODS_NO_MESSAGE, { item: item, index: i });
            }

            qty = parseInt(item.qty, 10);
            if (isNaN(qty) || qty < 1) {
                qty = 1;
            }

            payload.push({
                goodsNo: String(item.goodsNo),
                qty: qty
            });
        }

        timeoutId = setTimeout(function () {
            controller.abort();
        }, REQUEST_TIMEOUT);

        try {
            response = await fetch(API_URL, {
                method: 'POST',
                credentials: 'include',
                headers: buildHeaders(),
                body: JSON.stringify(payload),
                signal: controller.signal
            });

            result = await readJson(response);

            if (!response.ok) {
                throw createError(
                    (result && result.message) || DEFAULT_ERROR_MESSAGE,
                    { response: response, result: result }
                );
            }

            checkResult = result && result.CheckResult;
            cartResponse = result && result.CartResponse;

            if (!checkResult || !checkResult.IsSuccess) {
                throw createError(
                    extractCheckResultMessage(checkResult) || DEFAULT_ERROR_MESSAGE,
                    result
                );
            }

            if (!cartResponse || !cartResponse.IsSuccess) {
                throw createError(
                    (cartResponse && cartResponse.ResultMessage) || DEFAULT_ERROR_MESSAGE,
                    result
                );
            }

            return result;
        } catch (error) {
            if (error && error.name === 'AbortError') {
                throw createError(TIMEOUT_ERROR_MESSAGE, { error: error });
            }

            if (error && error.message && error.detail) {
                throw error;
            }

            throw createError(DEFAULT_ERROR_MESSAGE, { error: error });
        } finally {
            clearTimeout(timeoutId);
        }
    }

    function buildHeaders() {
        var cartNo = getCookie('CART_NO');
        var serviceCookies = getCookie('ServiceCookies');
        var headers = {
            'Content-Type': 'application/json; charset=utf-8'
        };

        if (cartNo) {
            headers['X-Cart-No'] = cartNo;
        }

        if (serviceCookies) {
            headers['X-Service-Cookies'] = serviceCookies;
        }

        return headers;
    }

    function normalizeCartItems(value) {
        if (value == null) {
            return [];
        }

        if (typeof value === 'string' || typeof value === 'number') {
            return [{ goodsNo: value, qty: 1 }];
        }

        if (Object.prototype.toString.call(value) === '[object Array]') {
            return value;
        }

        if (typeof value === 'object') {
            return [value];
        }

        return [];
    }

    function extractCheckResultMessage(checkResult) {
        var list = checkResult && checkResult.ResultList;
        var i;

        if (!list || !list.length) {
            return null;
        }

        for (i = 0; i < list.length; i++) {
            if (list[i] && list[i].ErrorMsg) {
                return list[i].ErrorMsg;
            }
        }

        return null;
    }

    function getCookie(name) {
        var cookieString = document.cookie || '';
        var cookies = cookieString ? cookieString.split('; ') : [];
        var prefix = name + '=';
        var i;

        for (i = 0; i < cookies.length; i++) {
            if (cookies[i].indexOf(prefix) === 0) {
                return decodeURIComponent(cookies[i].substring(prefix.length));
            }
        }

        return '';
    }

    async function readJson(response) {
        var text = await response.text();

        if (!text) {
            return null;
        }

        try {
            return JSON.parse(text);
        } catch (e) {
            return {
                message: text,
                rawText: text
            };
        }
    }

    function createError(message, detail) {
        var error = new Error(message);
        error.detail = detail;
        return error;
    }

    return {
        addCart: addCart,
        messages: {
            defaultSuccess: DEFAULT_SUCCESS_MESSAGE,
            defaultError: DEFAULT_ERROR_MESSAGE,
            invalidCartItems: INVALID_CART_ITEMS_MESSAGE,
            invalidGoodsNo: INVALID_GOODS_NO_MESSAGE,
            timeout: TIMEOUT_ERROR_MESSAGE
        }
    };
})();