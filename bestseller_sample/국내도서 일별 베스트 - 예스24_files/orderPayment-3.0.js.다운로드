    //옵션 추가/제거 후, 가격 계산
    var setPriceAreaForOptionGoods = function (current_option_seq, sender) {
        var sale_price = parseInt(original_sale_price.replaceAll(',', ''));     //최초가격
        var total_price = 0;
        var total_count = 0;
        var sale_price_per_option = 0;
        var opt_plus_price_per_option = 0;

        if (multi_option_array.length == 0) { //문구만 있는 경우
            total_count = parseInt($("*[name='ORD_GOODS_CNT']").val());
            total_price = sale_price * total_count;
        } else {

            multi_option_array.forEach(function (v, i) {
                //전체가격 계산
                total_price += (sale_price * v.count) + (v.opt_salepr * v.count);
                total_count += v.count;

                //현재 옵션 그룹의 가격 계산
                if (current_option_seq == v.seq_no) {
                    //옵션가가 있는 경우 옵션 영역 변경
                    if (v.opt_salepr > 0 || v.opt_salepr < 0) {
                        opt_plus_price_per_option = v.opt_salepr * v.count;
                    }
                    sale_price_per_option = (sale_price * v.count);
                }
            });
        }

        //옵션 그룹 가격
        if (sender != undefined) {
            var option_area = $(sender).parent().siblings();
            var sale_price_per_option_format = (sale_price_per_option).formatMoney(0);
            var opt_plus_price_per_option_format = (opt_plus_price_per_option).formatMoney(0);

            //현재 그룹 가격 세팅(수량 수동 변경 처리)
            $("#row_option_list_area" + current_option_seq).children().find("[name=sale_price_per_option]").text(sale_price_per_option_format);
            $("#row_gd_selGrpWrap" + current_option_seq).children().find("[name=sale_price_per_option]").text(sale_price_per_option_format);

            //옵션 가격 포맷
            var sale_price_per_option_text = "옵션가 " + opt_plus_price_per_option_format + "원";

            if (opt_plus_price_per_option > 0) {
                sale_price_per_option_text = "옵션가 +" + opt_plus_price_per_option_format + "원";
            }

            //현재 그룹 옵션 가격 세팅(수량 수동 변경 처리)
            if (option_area.find("[name=opt_plus_price_per_option]").length == 0) {
                $(sender).parent().parent().siblings().find("[name=opt_plus_price_per_option]").text(sale_price_per_option_text);
            }
            else {
                option_area.find("[name=opt_plus_price_per_option]").text(sale_price_per_option_text);
            }
        }

        $("#totalLayer").show();
        $("#gd_optBotWrap").show();

        //전체 가격세팅
        $("#total_order_price").text((total_price).formatMoney(0));
        $("#total_order_price_scrollbar").text((total_price).formatMoney(0));
        $("#total_order_price_scrollbar_layer").text((total_price).formatMoney(0));

        //전체 수량 세팅
        $("#total_order_count").text(total_count);
        $("#total_order_count_scrollbar").text(total_count);
        $("#total_order_count_scrollbar_layer").text(total_count);

        $("#total_order_scrollbar").show();
        $("#total_order_scrollbar_layer").show();
