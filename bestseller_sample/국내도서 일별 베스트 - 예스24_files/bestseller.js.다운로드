    filterCnt++;
}

// 검색 파라미터 생성하는 공통함수
function makeBestSellerParam(searchKey, val) {
    var url = window.location.search;
    var queryString = new URLSearchParams(url);
    type = queryString.get('type');

    switch (searchKey) {
        case "categoryNumber":
            if (val.substring(0, 3) == "017") {
                var eBookTp = (dictParam.eBookTp == null || dictParam.eBookTp == undefined) ? 0 : dictParam.eBookTp;
                initBestSellerParam();
                dictParam.eBookTp = eBookTp;
            }
            else {
                initBestSellerParam();
            }

            dictParam.categoryNumber = val;
            dictParam.pageNumber = 1;

            if (val.length > 9) {
                delete dictParam.age;
                delete dictParam.sex;
            }

            if (bestType == "DAY_BESTSELLER") {
                dictParam.type = "day";
            }
            else if (bestType == "WEEK_BESTSELLER") {
                var today = new Date();
                var date = new Date(today);
                date.setDate(today.getDate() - 1);

                var yearParam = date.getFullYear();
                var monthParam = date.getMonth() + 1;
                
                dictParam.type = "week";
                dictParam.saleYear = yearParam;
            }
            else if (bestType == "MONTH_BESTSELLER") {
                var today = new Date();
                var date = new Date(today);
                date.setDate(today.getDate() - 1);

                var yearParam = date.getFullYear();
                var monthParam = date.getMonth() + 1;

                dictParam.type = "month";
                dictParam.saleYear = yearParam;
                dictParam.saleMonth = monthParam;
            }
            break;
        case "page":
            dictParam.pageNumber = val;
            if (dictParam.categoryNumber.substring(0, 3) == "022") {
                dictParam.pageSize = 24;
            }
            else {
                dictParam.pageSize = $("#pg_size option:selected").val();
            }
            break;
        case "eBookTp":
            dictParam.pageNumber = 1;
        default:
            dictParam[searchKey] = val;
            break;
    }

    //Dictionary -> 검색파라미터로 변환
    return convertDictionaryToSearchParam(dictParam);
}

// Dictionary -> 검색파라미터로 변환
function convertDictionaryToSearchParam(dictParms) {
    var searchParam = [];

    Object.keys(dictParms).forEach(function (key) {
        searchParam.push(String.Format("{0}={1}", key, encodeURIComponent(dictParms[key])));
    });

    return searchParam.join("&");
}

// 파라미터 초기화
function initBestSellerParam() {
    for (var key in dictParam) {
        delete dictParam[key];
    }

    dictParam.pageNumber = 1;
    dictParam.pageSize = 24;
}

