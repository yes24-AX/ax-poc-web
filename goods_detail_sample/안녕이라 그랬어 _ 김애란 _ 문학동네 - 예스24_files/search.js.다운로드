//search ajax history
function addSearchHistoryListener(ajaxFunc) {
    try {
        window.addEventListener("popstate", function (e) {
            if (e.state) {
                //      console.log(e.state);
                ajaxFunc(e.state.query, e.state.sort, e.state.sortoption, e.state.domain, e.state.subdomain, e.state.suboption, e.state.minisubquery, e.state.subquery, e.state.subnotquery, e.state.salestat, e.state.page);
            }
            else {
                var query = $("#query").val();
                var sort = "POPULAR";
                var sortoption = "POPULAR";
                var domain = "ALL";
                var suboption = 0;
                var salestat = "ALL";
                var page = 1

                var pageState = { query: query, sort: sort, sortoption: sortoption, domain: domain, subdomain: "", suboption: "", minisubquery: "", subquery: "", subnotquery: "", salestat: salestat, page: page };
                // console.log(pageState);
                window.history.replaceState(pageState, "");
                //window.history.back();
            }
        }, false);
    }
    catch (e) {
        //console.log("error: addSearchHistoryListener");
    }
}

function bindSearchToHistory(query, sort, sortoption, domain, subdomain, suboption, minisubquery, subquery, subnotquery, salestat, page) {
    try {
        var pageState = { query: query, sort: sort, sortoption: sortoption, domain: domain, subdomain: subdomain, suboption: suboption, minisubquery: minisubquery, subquery: subquery, subnotquery: subnotquery, salestat: salestat, page: page };
        window.history.pushState(pageState, "");
        window.history.replaceState(pageState, "");
    }
    catch (e) {
        //console.log("error:bindSearchToHistory" + e.toString());
    };
}

