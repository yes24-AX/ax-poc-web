function check_limit_age(data) {
    var bRet = true;

    try {
        if (data.limit_age_yn == "Y") {
            if (data.limit_age > data.member_age && data.limit_age >= 19) {
                bRet = false;
            }
        }
    }
    catch (Exception) {
        alert("연령 체크 에러");
    }
    return bRet;
}

