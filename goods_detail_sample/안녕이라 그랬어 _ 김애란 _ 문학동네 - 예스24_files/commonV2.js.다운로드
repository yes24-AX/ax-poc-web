    var vEmailRule = /^[0-9a-zA-Z_.+-]([-_\.]?[0-9a-zA-Z])*@[0-9a-zA-Z]([-_\.]?[0-9a-zA-Z])*\.[a-zA-Z]{2,3}$/i;

    //빈값
    if (sEmlAddr.trim() == "" || sEmlAddr.trim() == "@" || sEmlAddr == undefined) {
