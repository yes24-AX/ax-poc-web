function GetErrorGoodsName(goods, contentMsgAction, beforeMsgAction, afterMsgAction) {
    var msg = '';
    for (var index = 0; index < goods.length; index++) {

        if (beforeMsgAction != undefined && beforeMsgAction != null) {
            msg += beforeMsgAction(goods[index]);
        }

        if (contentMsgAction != undefined && contentMsgAction != null) {
            msg += contentMsgAction(goods[index]);
        }
        else
            msg += '<br/> - ' + goods[index].goods_name;

        if (afterMsgAction != undefined && afterMsgAction != null) {
            msg += afterMsgAction(goods[index]);
        }
    }

    return msg;
}

