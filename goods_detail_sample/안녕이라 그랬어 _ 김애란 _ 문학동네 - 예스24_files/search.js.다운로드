                    var listcount = 0;

                    var strHistory = "";
                    for (var i = 0; i < arrHistory.length; i++) {
                        if (arrHistory[i] == $.trim(val))
                            continue;

                        if (strHistory == "")
                            strHistory = arrHistory[i];
                        else
                            strHistory += "。" + arrHistory[i];

                        listcount++;

                        if (listcount == 9)
                            break;
                    }

                    strHistory = $.trim(val) + "。" + strHistory;
                    x.setItem(_ScrHistory, strHistory);
                }
            });
        },
        removeItem: function (searchword) {
            x.getItem(_ScrHistory, function (allval, response) {
                var current_val = allval.replace(searchword + "。", "");
                x.setItem(_ScrHistory, current_val);
            });
        },
        removeItem: function (searchword) {
            x.getItem(_ScrHistory, function (allval, response) {
                var searchword_array = allval.split('。');
                var join_searchword = '';
                var current_idx = 0;
                $.each(searchword_array, function (i, v) {
                    if (v == searchword) {
                        current_idx = i;
                    }
                    else {
                        join_searchword += (searchword_array.length - 1) == i ? searchword_array[i] : searchword_array[i] + '。';
                    }
                });

                if (join_searchword.charAt(join_searchword.length - 1) == '。') {
                    join_searchword = join_searchword.slice(0, -1);
                }

                searchword_array.splice(current_idx, 1);
                x.setItem(_ScrHistory, join_searchword);

                srchHistory.show();
            });
        },
        clear: function () {
            setMcode(503);
            x.setItem(_ScrHistory, "");
            $("#search_recent").removeClass();
            $("#search_recent").addClass("noData");
            $("#search_recent").empty();
            $("<p id='searchword_empty' class='tit'>최근 검색어가 없습니다.</p>").appendTo("#search_recent");
        },
        show: function () {
            if ($("#query").val() != "")
                return;

            x.getItem(_ScrHistory, function (allval, response) {
                if (allval == null || allval.length == 0) {
                    $("#search_recent").removeClass();
                    $("#search_recent").addClass("noData");
                    $("#search_recent").empty();
                    $("<p id='searchword_empty' class='tit'>최근 검색어가 없습니다.</p>").appendTo("#search_recent");
                } else {
                    var arrHistory = allval.split('。');
                    $("#search_recent").removeClass();
                    $("#search_recent").addClass("rctRow");
                    $("#search_recent").empty();
                    var historyCount = arrHistory.length;
                    if (historyCount > 10)
                        historyCount = 10;

                    for (var i = 0; i < historyCount; i++) {
                        const keyword = arrHistory[i];
                        const trimedKeyword = $.trim(keyword);
                        if (keyword != "") {
                            var url = _SearchUrl + "/search?query=" + encodeURIComponent($.trim(arrHistory[i].replace('&#39;', '\'')));
                            var searchword_text = `
                                <span class="rctTxt">
                                    <a href="${url}" onclick="removeStorageSearchword();setMcode('515_001');insertSearchQuery('${keyword}')"; class="lnk_rct">
                                        <em class="txt">${trimedKeyword}</em>
                                    </a>
                                    <a href="javascript:void(0);" onclick="removeSearchItem(this,'${trimedKeyword}');" class="lnk_del"><em class="ico">삭제</em></a>
                                </span>
                            `;
                            $(searchword_text).appendTo("#search_recent");
                        }
                    }
                }
            });
        },
        hide: function () {
            $('#yKWD').show();
            $('#keyword_wrap').show();
        },
        decodeHtmlEntities: function (val) { // HTML 특수문자 디코딩
            var decodeHtmlEntity = document.createElement('textarea');
            decodeHtmlEntity.innerHTML = val;
            return decodeHtmlEntity.value;
        },
        encodeHtmlEntities: function (val) { // HTML 특수문자 인코딩
            var encdoeHtmlEntity = document.createElement('div');
            encdoeHtmlEntity.innerText = val;
            return encdoeHtmlEntity.innerHTML;
        }
    };
    srchHistory.show();
    setRemoveSearchword();

    if (IS_NATIVE_APPS && APP_GB == 'YES24') {
        var params = new URLSearchParams(window.location.search.toLowerCase());
        if (params.get('openimagesearch') == 'y') {
            goApp('IMAGESEARCH');
        }
    }
});
