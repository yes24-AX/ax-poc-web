//상품 정보 체크
function isAvailableGoodsForDetail(goods, order_count, cart_yn, list_yn, isMyList) {
    var result = true;

    if (goods.goods_state == "01" || goods.goods_state == "02") {
        if (!yes24GU.canBuyGoodsByAge(goods)) {
            if (goods.limit_age == null) {
                goods.limit_age = 19;
            }
            if (!loginUDetail.checkLoginByMsgAlert("[" + goods.limit_age.toString() == "15" ? "15" : "19" + "세 이상] 나이제한 상품입니다.\n로그인 후 이용하세요.")) {
                result = false;
            } else {
                //회원 연령 체크
                if (goods.limit_age <= goods.member_age && goods.limit_age >= 19) {
                    //인증 체크
                    if (!yes24GU.AdultCheck()) {
                        if (getCookie("AdultAuthYN") == "N") {
                            alert("[" + goods.limit_age.toString() == "15" ? "15" : "19" + "세 이상] 나이제한 상품입니다.");
                            result = false;
                        }
                        else result = false;
                    }
                }
                else {
                    if (goods.limit_age > goods.member_age) {
                        //TICKET-17596 나이제한 얼럿 문구 수정 요청
                        this.checkUnder19AdultMsgAlert(goods.limit_age);
                        result = false;
                    }
                }
            }
        }
        else if (goods.order_limit_yn == "Y" && order_count > goods.order_remain_count && !list_yn) {
            alert("[" + goods.goods_name + "]의 재고수량이 부족합니다.");
            result = false;
        }
        else if (goods.order_limit_count > 0 && order_count > goods.order_limit_count && !list_yn) {
            alert("[" + goods.goods_name + "]은(는) 최대허용 주문수량 [" + goods.order_limit_count + "]을 초과하였습니다.");
            result = false;
        }

        if (cart_yn) {
            if (goods.add_cart_yn == "N") {
                alert("[" + goods.goods_name + "]은 카트에 담을 수 없는 상품입니다.");
                result = false;
            } else if (goods.min_cnt > 0 && goods.max_cnt > 0 && !(order_count >= goods.min_cnt && order_count <= goods.max_cnt) && !list_yn) {
                alert("선택옵션에 맞는 주문수량을 구매하셔야 옵션가격을 적용받으실 수 있습니다.");
                result = false;
            } else if ((goods.opt_yn == "Y" || goods.opt_inst_yn == "Y") && list_yn) {
                alert("옵션 상품은 상품상세페이지에서 카트에 담을 수 있습니다.\n카트에 담지 못한 상품을 확인해주세요.\n\n상품명: " + goods.goods_name);
                result = false;
            }
        } else {
            if (goods.opt_inst_yn == "Y" && list_yn) {
                alert("주문옵션 기입이 필요한 상품이므로 바로구매 하실 수 없습니다.");
                result = false;
            } else if (goods.opt_yn == "Y" && list_yn) {
                alert("주문옵션 선택이 필요한 상품이므로 바로구매 하실 수 없습니다.");
                result = false;
            } else if (goods.min_cnt > 0 && goods.max_cnt > 0 && !(order_count >= goods.min_cnt && order_count <= goods.max_cnt) && !list_yn) {
                alert("선택옵션에 맞는 주문수량을 구매하셔야 옵션가격을 적용받으실 수 있습니다.");
                result = false;
            }
        }
    } else if (isMyList == false) {
        alert("[" + goods.goods_name + "](일시품절 상품)은 카트에 담을 수 없는 상품입니다.");
        result = false;
    }
    return result;
};

