    //우측상품검색: API 콜백 함수
    BulletSearchGoodsCallBack: function (data) {
        //추천 상품있으면 영역 노출
        $('#latestSearchList').hide();
        $('#suggestSearchList').show();
        $('#searchKeyLayer').show();

        var $gl = $("#suggest_goodsList");

        if (data != null && data.lstSearchKeywordResult.length > 0) {
            if ($("#query").val().trim() == '') {
                $('#suggestSearchList').hide();
                $('#latestSearchList').show();
                return;
            }
            var GoodsList = " ";
            $.each(
                data.lstSearchKeywordResult,
                function (i, entity) {
                    //우측 검색결과 영역 HTML 생성
                    GoodsList += BulletSearchRenewal.getSuggestGoodsHtml(i, entity);
                }
            );

            $gl.html(GoodsList);
            $("#suggestPaging").show();
            $gl.show();

            // 총수량을 올바르게 가져왔다면 페이저를 refresh해준다.
            iTotalCount = data.iGoodsTotalCount;
            BulletSearchRenewal.getPager();
        }
        else {
            //추천 상품 없는 경우 숨김처리
            $('#suggestSearchList').hide();
            $('#searchKeyLayer').hide();
        }
    },




