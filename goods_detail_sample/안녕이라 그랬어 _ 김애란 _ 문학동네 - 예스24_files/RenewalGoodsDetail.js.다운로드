// 2024 상품상세 리뉴얼 리뷰 / 한줄평 영역 스위칭
function switchRevwSec(obj) {
    var tarId = $(obj).attr("name");

    if (!$(obj).hasClass("on")) {
        switch (tarId) {
            case 'oCmtTabBtn':
                $('a[name=oCmtTabBtn]').addClass("on");
                $('a[name=revwTabBtn]').removeClass("on");
                $('#oCmtWrap').css('display', '');
                $('#revwWrap').css('display', 'none');
                break;
            default:
                $('a[name=revwTabBtn]').addClass("on");
                $('a[name=oCmtTabBtn]').removeClass("on");
                $('#revwWrap').css('display', '');
                $('#oCmtWrap').css('display', 'none');
                break;
        }
    }
}
