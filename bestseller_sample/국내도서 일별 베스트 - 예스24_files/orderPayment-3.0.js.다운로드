    var upOrderCount = function (goodsNo, isUsedGoods, remainCnt) {
        var ordCountObj = $("#ordCnt_" + goodsNo);
        var goodsOptObj = $("#ordOpt_" + goodsNo);

        var ordCnt = ordCountObj.val();
        var goods = eval("(" + goodsOptObj.val() + ")");

        if (ordCountObj) {
            old_qty = parseInt(ordCountObj.val(), 10);
            if (isUsedGoods == null) { isUsedGoods = false; remainCnt = 0; }

            if (isUsedGoods && remainCnt < old_qty + 1)
                alert('본 상품은 한정수량 상품으로 ' + remainCnt + '개 이상으로는 주문할 수 없습니다.');
            else {
                if (ordCnt >= 9999) {
                    alert("수량은 최대 9999개까지 선택 가능합니다.");
                } else {
                    ordCountObj.val(old_qty + 1);
                }
            }

            if (!isUsedGoods)
                checkSalesInterestFree(ordCountObj.val(), goodsNo);
        }
        return;
    };

