$(document).ready(function () {
    BulletSearchRenewal.InitBulletSearch();

    // browser별 keyup binding
    if (typeof jQuery.browser == 'undefined') {
        jQuery.browser = {};
        jQuery.browser.ie = /MSIE/.test(navigator.userAgent.toLowerCase());
        jQuery.browser.mozilla = (/mozilla/.test(navigator.userAgent.toLowerCase()) && !/webkit/.test(navigator.userAgent.toLowerCase()))
        jQuery.browser.opera = /opera/.test(navigator.userAgent.toLowerCase());
    }

    if (jQuery.browser.ie == true) {
        $(InputTextBoxID).bind("keyup", function (e) { BulletSearchRenewal.Check(e); });
    }
    else if (jQuery.browser.mozilla == true || jQuery.browser.opera == true) {
        $(InputTextBoxID).bind("keyup", function (e) {
            BulletSearchRenewal.trick();
            BulletSearchRenewal.Check(e);
        });
    }
    else {
        $(InputTextBoxID).bind("keyup", function (e) {
            BulletSearchRenewal.Check(e);
        });

        $(InputTextBoxID).bind("keydown", function (e) {
            switch (e.keyCode) {
                case 38: // 위로
                    e.preventDefault();
                    break;
            }
        });
    }

    $(InputTextBoxID).click(function () {
        if ($('input#query').val().trim().length > 0) {
