function MobilePopularBack(data) {

    $("#search_popular").empty();

    if (data.List.length == 0) {
        $("#search_popular").hide();
        $("#search_popular_nodata").show();
        if ($('#search_popular_nodata > p.tit').length == 0){
            $("<p class='tit'>인기 검색어를 집계 중입니다.</p>").appendTo("#search_popular_nodata");
        }
        return;
    }
    $("#search_popular_nodata").hide();
    $("#search_popular").show();

    var hosturl = $("#hdMainHost").val();

    _SearchType = getSearchType();
    _SearchUrl = MOBILE_URL;

    if (_SearchType == "BOOKSHOP") {
        _SearchUrl = BOOKSHOP_URL;
    }

    data.List.forEach((s) => {
        const url = `${_SearchUrl}/search?query=${encodeSearchQuery(s)}`;
        const listItem = `
        <li>
            <a href="${url}" onclick="removeStorageSearchword(); setMcode('515_002'); insertSearchQuery('${s}')">
                <em class="txt">${s}</em>
            </a>
        </li>
    `;
        $("#search_popular").append(listItem);
    });
    if (data.SearchDate != undefined && data.SearchDate != "") {
        $("#date_search_popular").text(data.SearchDate.replaceAll("-", "."));
    }
}

