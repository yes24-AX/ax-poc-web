// 하위 전시분류를 연다
function OpenSubDepth(dispNo, e, obj) {
    // 중고샵은 3Depth 까지만 연다.
    if (dispNo.substring(0, 3) == "018" && dispNo.length > 9) {
        return false;
    }
    // + 버튼 클릭 시
    if ($(obj).hasClass("lnk_toggle")) {
        // 해당 전시 분류의 하위 전시분류가 없을 때
        if ($(obj).parents("li:first").children("ul.subDpt").length == 0) {
            AddSubDepth(dispNo, '', obj);
        }
    }
    // 메뉴 클릭 시
    else {
        AddSubDepth(dispNo);
    }
    // li의 이벤트가 propagation되는 것을 막는다.
    if (e.stopPropagation) {
        e.stopPropagation();
    }
    e.cancelBubble = true;
}

// 하위 전시분류 비동기 호출
// fullDispNo 는 도메인에 categoryNumber를 입력하여 들어온 경우, 페이지 새로고침 등 링크 이동된 경우에만 존재
function AddSubDepth(dispNo, fullDispNo, obj) {
    var category = $('#category' + dispNo);
    var list = $(category).find("ul:first");
    // 하위 전시분류가 있거나 2Depth 일때
    if ($(list).length > 0 || dispNo.length == 6) {
        if (fullDispNo != null) {
            if (dispNo.length < fullDispNo.length) {
                subDispNo = fullDispNo.substring(0, dispNo.length + 3);
                AddSubDepth(subDispNo, fullDispNo);
            }
            else {
                $("a.lnk_cate").removeClass("on");
                $(category).find("a:first").addClass("on");
            }
        }
    }
    // 하위 전시분류가 없을 때
    else {
        // 일별 베스트의 경우 AJAX로 값을 부르지 않는다. 2depth이하를 보여주지 않는다.
        if (bestType != "DAY_BESTSELLER") {
            // 전시번호가 있고 최하위 전시가 아닐 때
            if (dispNo != '' && !$(category).hasClass("lastDpt")) {
                $.ajax({
                    type: "GET",
                    url: "/product/category/BestSellerSubCategory",
                    data: {
                        categoryNumber: dispNo,
                        bestType: bestType
                    },
                    success: function (result) {
                        $("#category" + dispNo).append(result);
                        // 도메인에 카테고리 번호를 입력한 경우 좌측 전시 메뉴 세팅
                        if ($(list).length == 0 && fullDispNo != null && dispNo.length < fullDispNo.length) {
                            subDispNo = fullDispNo.substring(0, dispNo.length + 3);
                            AddSubDepth(subDispNo, fullDispNo);
                        }
                        else {
                            // + 버튼 클릭이 아닐 경우
                            if (!$(obj).hasClass("lnk_toggle")) {
                                $("a.lnk_cate").removeClass("on");
                                $(category).find("a:first").addClass("on");
                            }
                            if (!$(category).hasClass("open")) {
                                $(category).addClass("open");
                            }
                        }
                    }
                });
            }
        }
    }

    if (!$(category).hasClass("open")) {
        if (toggleReturn == false) {
            $(category).toggleClass("open");
        }
        if ($(category).hasClass("lastDpt")) {
            $("a.lnk_cate").removeClass("on");
            $(category).find("a:first").addClass("on");
        }
    }
}

