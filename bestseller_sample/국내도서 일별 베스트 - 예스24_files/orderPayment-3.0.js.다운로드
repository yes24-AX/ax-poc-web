        }

        //현재 옵션영역의 주문수량
        var ord_count = parseInt(txt_ord_count.val());
        if (isNaN(ord_count) || ord_count == "") {
            alert("1개 이상 구매 가능합니다.");
            ord_count = 1;
        }

        if (change_tp == "plus") {
            ord_count += 1;

            if (ord_count >= 1001) {
                alert("[" + data.goods_name + "]은(는) 최대허용 주문수량 1,000을 초과하였습니다.");
                return false;
            }

            //옵션상품 배열의 상품 수 증가
            multi_option_array.forEach(function (v, i) {
                if (current_option_seq == v.seq_no) {
                    v.count += 1;
                }
            });
        }
        else if (change_tp == "minus") {
            if (ord_count > 1) {
                ord_count -= 1;
