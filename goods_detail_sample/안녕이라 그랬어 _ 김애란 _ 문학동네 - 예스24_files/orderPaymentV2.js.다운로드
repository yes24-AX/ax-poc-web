            total_price += (g_SalePrice * value.count) + (value.opt_salepr * value.count);
            total_count += value.count;
        });
        $("#totalPrice").text(parseInt(total_price).formatMoney(0));
        $("#totalCount").text(parseInt(total_count).formatMoney(0));
    }

