}

// 모바일 전용 총알검색
function getMobileSuggest(strQuery, iDomain) {
    _SearchType = getSearchType();

    var prehost = $("#hdPreHost").val();
    var webApiUrl = prehost + "www.yes24.com/Product/searchapi/bulletsearch/goodsJsonp";
    if (strQuery != null && strQuery.length > 80) strQuery = strQuery.substring(0, 80);
    var seq = _MobileSuggestResponseSeq++;
    var frontApiUrl = FRONT_API_URL + "/api/search/goods";

    $.ajax({
    url: frontApiUrl,
    dataType: "json",
    xhrFields: {
        withCredentials: true,
    },
    data: { query: strQuery, domain: "ALL", page: 1, size: 10 },
    success: function (data) {
        mobileSuggestCallBack(data, seq);
    }});

}

// 모바일 전용 총알검색 callback
function mobileSuggestCallBack(data, seq) {
    if (seq >= _MobileSuggestRequestSeq) {
        _MobileSuggestRequestSeq = seq;
    }
    else {
        return;
    }
    $("#search_suggest").empty();
    var hosturl = $("#hdMainHost").val();

    _SearchType = getSearchType();
    _SearchUrl = MOBILE_URL;

    if (_SearchType == "BOOKSHOP") {
        _SearchUrl = BOOKSHOP_URL;
    }

    var suggestLength = data.SearchResults.length;
    if (suggestLength > 10) {
        suggestLength = 10;
    }
    for (var i = 0; i < suggestLength; i++) {
        var s = data.SearchResults[i].GOODDS_INDEXES;
        var url = _SearchUrl + "/goods/detail/" + s.GOODS_NO;
        if (s.RES_KEY_GB == "41") {
            url = protocol + "//m.shiftbooks.yes24.com/Detail/" + s.MCODE;
        }
        else if (s.RES_KEY_GB == "47") {
            url = protocol + "//story24.yes24.com/story/detail?goodsNo=" + s.GOODS_NO;
        }
        if (GetDomain(s.DOMAIN) == "99") {
            $("<li><a href=\"" + url + "\" onclick=\"clickSuggestSearch(\'" + s.GOODS_NO + "\');\"><em class=\"txt\"> " + s.GOODS_NM + "</em></a></li>").appendTo("#search_suggest");
        }
        else {
            $("<li><a href=\"" + url + "\" onclick=\"clickSuggestSearch(\'" + s.GOODS_NO + "\');\"><em class=\"txt\">[" + (s.RES_KEY_GB == "49" ? "클래스24" : GetDomain(s.DOMAIN)) + "] " + s.GOODS_NM + "</em></a></li>").appendTo("#search_suggest");
        }
    }

}
