    // keypress에 대한 이벤트
    Check: function (e) {
        KeyCode = e.keyCode;

        switch (KeyCode) {
            case 38: // 위로
                if ($("#suggest_wordList").children().length == 1) {
                    return false;
                }
                istrick = false;
                if (KsanaIndex > 0) {
                    KsanaIndex--;
                } else {
                    KsanaIndex = KsanaCount - 1;
                }
                BulletSearchRenewal.clickLoggingTrace("105");
                BulletSearchRenewal.SelectItem();
                break;
            case 40: // 아래로
                if ($("#suggest_wordList").children().length == 1) {
                    return false;
                }
                istrick = false;
                if (KsanaIndex < (KsanaCount - 1)) {
                    KsanaIndex++;
                } else {
                    KsanaIndex = 0;
                }
                BulletSearchRenewal.clickLoggingTrace("105");
                BulletSearchRenewal.SelectItem();
                break;
            case 16: // 쉬프트, 아무액션없는 키들
            case 17: // 컨트롤
            case 18: // 알트
            case 19: // pause,break
            case 20: // caps lock
            case 37: // 좌
            case 39: // 우
            case 32: // 공백
                break;
            case 13: // enter;
                e.preventDefault();
                BulletSearchRenewal.ShowSuggest();
                $("#yesSForm").submit();
                break;
            case 27: // ESC
                BulletSearchRenewal.HideBulletSearch();
                break;
            case 8: // 백스페이스
                BulletSearchRenewal.ShowSuggest();
                break;
            default:
                BulletSearchRenewal.ShowSuggest();
                break;
        }
    }
