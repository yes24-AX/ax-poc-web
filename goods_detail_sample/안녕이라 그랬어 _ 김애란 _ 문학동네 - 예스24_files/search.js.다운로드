function searchGoods() {
    _SearchType = getSearchType();
    _SearchUrl = MOBILE_URL;

    if (_SearchType == "BOOKSHOP") {
        _SearchUrl = BOOKSHOP_URL;
    }

    var search_domain = $("#hdSearchCategory").val() == '' ? 'ALL' : $("#hdSearchCategory").val();
    var search_query = $.trim($("#query").val());

    if (search_query == "") {
        alert("검색어를 입력하세요.");
        return false;
    }

    if (window.localStorage.length > 0) {
        try {
            window.localStorage.removeItem("SearchPageState");
        } catch (e) { }
    }

    // 크레마 관련 검색어 예외처리 (TICKET-21409, TICKET-26130)
    var negativeQuerys = ['크레마', 'crema', '모티프', '크레마모티프', '크레마 모티프', '크레마 페블', '크레마페블', '크레마이북리더기', '크레마 이북 리더기', '크레마 리더기', '이북단말기', '이북 단말기', '단말기', '이북리더기', '이북 리더기', '리더기']
    if (negativeQuerys.includes(search_query.toLowerCase())) {
        search_domain = "GIFT";
    }

    document.location.href = _SearchUrl + '/search?domain=' + search_domain + '&query=' + encodeSearchQuery(search_query);
}

function showSuggest() {
    var q = $('#query').val().trim();
    if (q.length == 0)
        return;

    clearTimeout(_MobileSuggestTimer);
    _MobileSuggestTimer = setTimeout(function () { getMobileSuggest(q, '0'); }, 300);
}

