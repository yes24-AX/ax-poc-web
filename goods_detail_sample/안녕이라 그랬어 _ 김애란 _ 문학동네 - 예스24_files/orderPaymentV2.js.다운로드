    //주문수량 증가/감소 세팅(멀티옵션)
    var setMultiOptionOrderCount = function (sender) {
        let type = $(sender).data().type;
        var optionRow = $(sender).closest('.optRow');
        var objOption = optionRow.data().optionObject;
        var txtCount;
        var currentCount;

        if (type != undefined && type != "" && type != null) {
            txtCount = $(sender).siblings('.opt_ipt').find('input[type=number]');
            currentCount = txtCount.val();

            //0이 되는 경우 return
            if (type == 'minus' && currentCount == 1) {
                return;
            }
        } else {
            checkMaxCount(sender);
            txtCount = $(sender);
            currentCount = parseInt(txtCount.val());
        }

        //재고수량을 초과할 경우 return
        if (objOption.order_limit_yn == "Y" && currentCount == objOption.order_remain_count) {
            alert('재고수량이 부족합니다.');
            return;
        }
        //한정상품의 제한수량을 초과할 경우 return
        else if (objOption.order_limit_count > 0 && currentCount == objOption.order_limit_count) {
            alert('최대허용 주문수량을 초과하였습니다.');
            return;
        }

        //수량변경사항 전역변수에 반영
        $.each(multi_option_array, function (index, value) {
            if (value.goods_seq == objOption.goods_seq) {

                if (type != undefined && type != "" && type != null) {
                    if (type == "plus") {
                        value.count += 1;
                    }
                    else {
                        value.count -= 1;
                    }
                    txtCount.val(value.count);
                } else {
                    value.count = currentCount;
                }

                let price = (g_SalePrice * value.count);
                let optPrice = (value.opt_salepr * value.count);
                optionRow.find(".cost .price .yes_m").text(price.formatMoney(0));
                optionRow.find(".cost .plus").text(`+옵션가 ${optPrice.formatMoney(0)}원`);
                return;
            }
        });

        setPriceAreaForOptionGoods();   //가격계산
    }

    //가격 및 수량 계산
