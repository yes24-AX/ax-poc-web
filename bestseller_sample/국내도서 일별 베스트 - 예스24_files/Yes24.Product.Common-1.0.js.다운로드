//카트담기 ajax호출 - eBook대표상품
function ajaxCartDataForEBookMaster(cartData, categoryNumber, codeName, code, goodsGb) {
    var r = '';
    var carturl = NOW_YES_HTTP_URL + YES_CART_AJAX_URL + '?CategoryNumber=' + categoryNumber + "&GoodsGb=" + goodsGb;
    if (codeName != null)
        carturl = urlUDetail.getClickCodeUrl(carturl, codeName, code);

    try {
        jQuery.ajax({
            type: 'POST',
            cache: false,
            async: false,
            dataType: 'json',
            url: carturl,
            data: 'CART_GOODS_INFO=' + encodeURIComponent(cartData),
            success: function (data) {
                if (!data.IsSuccess)
                    r = data.ResultMessage;
            },
            error: function (xhr, ajaxOptions, thrownError) { r = thrownError; }
        });
    } catch (e) { r = e.description; }

    return r;
};

