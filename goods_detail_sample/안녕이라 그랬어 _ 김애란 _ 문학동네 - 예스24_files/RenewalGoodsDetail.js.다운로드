// 상품의 분철 옵션 핸들링
function PartBookSelectBox(element, options) {

    this.partBooks = options;

    this.initpartbook = function () {
        var selectpartbook = this.partbookrender(partBooks);
        $(element).replaceWith(selectpartbook);
    };

    this.partbookvalue = function () {
        return $('.optSelFileBreak .selTp01:last').val();
    };

    this.partbooktext = function () {
        return $('.optSelFileBreak .selTp01:last').text()
    };

    this.partbookrender = function (options) {

        partbookblank = $('<option value="-2">스프링분철 서비스를 선택하세요</option>');
        partbookselect = $('<select class="selTp01" id="SelectGoodsPartBooks" onchange="ychangeForPartBook(this);" name="PARTBOOK_VALUE"></select>').append(partbookblank).hide();

        $.each(options, function (text, val) {

            partBooks = $('<option></option>').text(text);

            partBooks.attr('value', val);

            partbookselect.append(partBooks);
            partbookselect.show();
        });

        partbookblank.attr('selected', 'true');

        return partbookselect;
    };

    this.initpartbook();
}

function ychangeForPartBook(element) {

    index = $('.optSelFileBreak .selTp01').index(element);

    $('.optSelFileBreak .selTp01:gt(' + index + ')').remove();

    if ($(element).val() == -2) {
        checkDelvDate($(element).val())
        return;
    }

    if ($(element).val() != -1) {
        $(this).attr('name', 'PARTBOOK_VALUE');
        checkDelvDate($(element).val())
        return;
    }

    partBooks = self.partBooks;

    $('.optSelFileBreak .selTp01 *:selected').each(function () {
        key = $(this).text();
        partBooks = partBooks[key];
    });

    $(this).after(self.partbookrender(partBooks));
}

