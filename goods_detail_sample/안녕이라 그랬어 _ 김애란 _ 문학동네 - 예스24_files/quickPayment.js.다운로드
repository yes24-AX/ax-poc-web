//유효성 검증 request 파라미터 생성
function getQuickPaymentData() {
    const quantity = $("*[name='ORD_CNT']").val() || setTotalCountForQuickPaymentOptionGoods();
   
    //상품데이터 구성
    const items = (typeof multi_option_array === "undefined")
        ? [{
            GoodsNo: parseInt(g_GoodsNo),
            GoodsSeq: 1,
            Quantity: parseInt(quantity),
            Amount: g_SalePrice * quantity,
            OptionMessage: typeof optionMessage == "undefined" ? '' : optionMessage
        }]
        : multi_option_array.map(function (item) {
            return {
                GoodsNo: g_GoodsNo,
                GoodsSeq: item.goods_seq,
                Quantity: item.count,
                Amount: (parseInt(item.opt_salepr) + parseInt(g_SalePrice)) * item.count,
                OptionMessage: item.option_message == undefined ? '' : item.option_message
            };
        });
   
    const requestQuickData = {
        "Timestamp": quickPaymentToken.Timestamp,
        "Token": quickPaymentToken.Token,
        "Signature": quickPaymentToken.Signature,
        "MethodInfo": {
            "Method": quickPaymentMethod.payMethod,
            "MethodToken": quickPaymentMethod.payToken,
            "CardQuota": cardQuota,
            "CardInterest": cardInterest
        },
        "Items": items,
        "ShippingInfo": getShippingInfo(),
        "ShippingFee": delvFee,
        "TotalAmount": totalPrice + delvFee
    }

    return requestQuickData;
}

//빠른결제 실패 로그 적재
function sendQuickPaymentLog(response) {
    let errorBody = {};

    try {
        if (!response) {
            errorBody = { message: "응답 없음" };
        } else if (response instanceof TypeError) {
            errorBody = {
                name: response.name,
                message: response.message,
                stack: response.stack ?? null
            };
        } else if (!response.IsSuccess) {
            errorBody = JSON.parse(JSON.stringify(response));
        } else {
            errorBody = {
                status: response.status,
                statusText: response.statusText,
                url: response.url,
                traceId: response.traceId ?? "",
                message: response.message ?? "",
                errors: response.errors ?? ""
            };
        }
    } catch (e) {
        let errorType = "UnknownError";
        if (e instanceof TypeError) errorType = "TypeError";
        else if (e instanceof ReferenceError) errorType = "ReferenceError";
        else if (e instanceof SyntaxError) errorType = "SyntaxError";

        errorBody = {
            name: errorType,
            message: e.message,
            stack: e.stack ?? null
        };
    }

    if (response.IsSuccess != true) {
        const sendQuickPaymentLogConfig = new RequestConfig({
            domain: _MOBILE_URL,
            url: "/Goods/WriteQuickPaymentLog",
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            bodyData: {
                sMessage: response.ResultCode ? response.ResultCode : response.message ? response.message : '',
                iGoodsNo: g_GoodsNo,
                sRequestData: JSON.stringify(getQuickPaymentData()),
                sError: JSON.stringify(errorBody)
            },
            responseType: "text",
            callback: null
        });

        fetchApi(sendQuickPaymentLogConfig);

        //토큰 만료
        if (response.ResultCode === "SIGNATURE_VALIDATE") {
            oneBtnDialog.show('알림', '결제시간이 만료되었습니다. 다시 진행 해 주세요.', '확인');
        } else if (response.ResultCode === "ERROR_SEYPAY_MEMBER") {
            oneBtnDialog.show('알림', '결제 정보 조회에 실패했습니다. 다시 진행 해 주세요.', '확인');
        }
        else if (response.timeout) {
            oneBtnDialog.show('알림', '서버 응답이 지연되고 있습니다. 다시 진행 해 주세요.', '확인');
        }
        else {
            oneBtnDialog.show('알림', '빠른 결제에 실패하였습니다.', '확인');
        }

        closeOpt();
    }
}

//결제 정보 조회
function getShippingInfo() {
    const encodedInfo = {};

    for (const key in quickPaymentAddress) {
        if (quickPaymentAddress.hasOwnProperty(key)) {
            encodedInfo[key] = encodeURIComponent(quickPaymentAddress[key]);
        }
    }

    return encodedInfo;
}

