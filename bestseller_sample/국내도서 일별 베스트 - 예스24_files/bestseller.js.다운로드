// 검색 파라미터 세팅
function changeBestSellerParam(obj, val) {
    hidePopup();

    var url = window.location.search;
    var queryString = new URLSearchParams(url);
    var pageSize = queryString.get('pageSize') == null ? "24" : queryString.get('pageSize');

    var dataType = $(obj).attr("data-search-type");
    var params = "";
    // type이 undefined 이면 부모 type 호출
    if (dataType == undefined) {
        dataType = $(obj).parent().attr("data-search-type");
    }
    // value 값 셋팅
    var attrVal = $(obj).attr("data-search-value");
    attrVal = (attrVal == '' || attrVal == undefined) ? val : attrVal;

    bindFilterSelections(dataType, attrVal, obj);

    switch (dataType) {
        case "categoryNumber":
            dictParam.categoryNumber = attrVal;
            break;
        case "page":
            dictParam.pageNumber = attrVal;
            break;
        case "sex":
        case "age":
        case "goodsTp":
        case "addOptionTp":
        case "excludeTp":
        case "goodsStatGb":
        case "pageSize":
        case "freeYn":
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize;
            break;
        case "saleDts":
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize;
            attrVal = $("#scope_year").val() + "-" + $("#scope_month").val().padStart(2, "0") + "-" + $("#scope_day").val().padStart(2, "0");
            dictParam.saleDts = attrVal;
            break;
        case "type":
            var today = new Date();
            var date = new Date(today);
            date.setDate(today.getDate() - 1);
            if (val == "month") {
                delete dictParam.weekNo;
            }
            else if (val == "week") {
                delete dictParam.saleMonth;
                delete dictParam.weekNo;
            }
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize == "" || pageSize == null ? 24 : pageSize;
            dictParam.type = attrVal;
            break;
        case "saleYear":
            dictParam.saleYear = val;
            dictParam.pageNumber = 1;
            dictParam.pageSize = pageSize == "" || pageSize == null ? 24 : pageSize;
            if (type == "month") {
                dictParam.saleMonth = 1;
            }
            else if (type == "week") {
                delete dictParam.weekNo;
            }
            break;
        case "saleMonth":
