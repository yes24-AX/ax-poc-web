function getDetailView(divId, actionLink, isLoading) {

    if ($.inArray(divId, detailViewArray) == -1) {

        // 로딩이미지 표시
        if (isLoading !== undefined && isLoading == true)
            loadingShow();

        $('#' + divId).load(
            actionLink
            , function () {

                // 로딩이미지 숨김
                if (isLoading !== undefined && isLoading == true)
                    loadingHide();
                detailViewArray.push(divId);
            }
        );
    }
}

