//검색타입 가져오기 (도매몰 여부 체크)
function getSearchType() {
    var currentHost = location.host.toLowerCase();
    var currentPathname = location.pathname.toLowerCase();

    //도매몰 접근일 경우 (ssl.yes24.com 도매몰 경로 추가)
    if (currentHost === "ssl.yes24.com") {
        if (currentPathname.includes("/bookshop/") ||
            currentPathname.includes("/bookshopmypage/")) {
            _SearchType = "BOOKSHOP";
        }
    } else {
        if (BOOKSHOP_URL.toLowerCase().includes(currentHost)) {
            _SearchType = "BOOKSHOP";
        }
    }

    return _SearchType;
}

