    //멀티 옵션 상품 유효성 검사
    var checkValidMultiOptionGoods = function () {
        //상품메타 정보
        var json = { errorCode: 0, result: true, msg: '' };
        var result = true;
        var data = JSON.parse($("*[name='ORD_GOODS_OPT']").val());

        //옵션별 주문 가능 갯수 체크
        multi_option_array.forEach(function (v, i) {
            var order_cnt = v.count;
            var order_from_cnt = v.goods.min_cnt;
            var order_to_cnt = v.goods.max_cnt;
            if (order_to_cnt > 0 && order_from_cnt > 0) {
                if (order_cnt < order_from_cnt || order_cnt > order_to_cnt) {
                    json.errorCode = -10;
                    json.result = false;
                    json.msg = "선택옵션에 맞는 주문수량을 구매하셔야 옵션가격을 적용받으실 수 있습니다.";
                    return false;
                }
            }
        });

        //판매예정, 판매중인 상품만 장바구니에 담는다.
        if (json.result) {
            //연령제한
            if (data.limit_age_yn == "Y") {
                if (data.limit_age == null) {
                    data.limit_age = 19;
                }
                //성인상품이고 로그인하지 않음
                if (!check_login()) {
                    json.errorCode = -4;
                    json.result = false;
                    json.msg = '[' + data.limit_age.toString() == "15" ? "15" : "19" + '세 이상] 나이제한 상품 입니다. 로그인 후 이용하세요';
                }
                else {
                    //성인상품이지만 로그인함.
                    //상품의 제한 연령 체크
                    if (data.limit_age >= 19) //성인 인증 필요한 상품
                    {
                        if (data.member_age >= data.limit_age) {
                            //성인 인증 여부한 여부 체크
                            var adultCookie = getCookie('AdultAuthYN');
                            var adultAuth = adultCookie == null || adultCookie == undefined ? 'N' : adultCookie;

                            if (adultAuth != 'Y') {
                                //-10 성인 인증 이동 로직 포함
                                json.errorCode = -10;
                                json.result = false;
                            }
                        }
                        else {
                            json.errorCode = -5;
                            json.result = false;
                            json.msg = '[' + data.limit_age.toString() == "15" ? "15" : "19" + '세 이상] 나이제한 상품 입니다.', '확인';
                        }

                    }
                    else if (data.limit_age > data.member_age) {
                        json.errorCode = -5;
                        json.result = false;
                        json.msg = '[' + data.limit_age.toString() == "15" ? "15" : "19" + '세 이상] 나이제한 상품 입니다.', '확인';
                    }

                }
            }
            else if (data.order_limit_yn == "Y") {
                multi_option_array.forEach(function (v, i) {
                    var order_cnt = v.count;
                    if (order_cnt > v.goods.order_remain_count) {
                        json.errorCode = -6;
                        json.result = false;
                        json.msg = "[" + data.goods_name + "]의 재고수량이 부족합니다.";
                        return false;
                    }
                });
            }
            else if (data.order_limit_count > 0) {
                multi_option_array.forEach(function (v, i) {
                    var order_cnt = v.count;
                    if (order_cnt > data.order_limit_count) {
                        json.errorCode = -8;
                        json.result = false;
                        json.msg = "[" + data.goods_name + "]은(는) 최대허용 주문수량 [" + data.order_limit_count + "]을 초과하였습니다.";
                        return false;
                    }
                });
            }
        }
        return json;
    };

