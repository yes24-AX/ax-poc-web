// 바이트로 자르기
String.prototype.cutByte2 = function (len, suffix) {
    var str = this;
    var count = 0;
    var fixedSuffix = ''

    for (var i = 0; i < str.length; i++) {
        if (escape(str.charAt(i)).length >= 4) {
            count += 2;
        } else {
            if (escape(str.charAt(i)) != "%0D") {
                count++;
            }
        }

        if (count > len) {
            if (escape(str.charAt(i)) == "%0A")
                i--;

            fixedSuffix = suffix

            break;
        }
    }
    return str.substring(0, i) + fixedSuffix;
}


