    // 읽어온 총개수에 따라 페이저를 그려준다.
    getPager: function () {
        if ($.trim($(InputTextBoxID).val()) == "") {
            return;
        }
        if (iTotalCount < 1) {
            return;
        }
        var iStartPage = 0;
        var iEndPage = 0;

        var sbPager = "";
        if (iTotalCount > 0) {
            iTotalPage = iTotalCount / iPageSize;

            if ((iTotalCount % iPageSize) > 0) {
                iTotalPage = iTotalPage + 1;
            }

            iStartPage = (iPage - (iPage % iDispPageCnt == 0 ? iDispPageCnt : iPage % iDispPageCnt)) + 1;

            if (iTotalPage < (iStartPage + (iDispPageCnt - 1)))
                iEndPage = iTotalPage;
            else
                iEndPage = iStartPage + (iDispPageCnt - 1);


            if (iEndPage > 5) iEndPage = 5;
            for (var j = iStartPage; j <= iEndPage; j++) {
                if (j == iPage) {
                    sbPager = sbPager + "<strong class=\"num\">" + j + "</strong> ";
                }
                else {
                    sbPager = sbPager + "<a href=\"javascript:BulletSearchRenewal.GoPage(" + j + ");\" class=\"num\">" + j + "</a> ";
                }
            }

        }

        $("#suggestPaging").html(sbPager);
        $("#suggestPaging").unbind("mouseover");
    }
