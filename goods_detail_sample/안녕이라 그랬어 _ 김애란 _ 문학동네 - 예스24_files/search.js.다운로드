//도메인 문자를 변환해주는 함수
function GetDomain(strDomain) {
    switch (strDomain) {
        case "00": case "0": return "전체";
        //case "01": case "1": return "국내도서";
        case "01": case "1": return "도서";
        case "02": case "2": return "외서";
        case "03": case "3": return "eBook";
        case "04": case "4": return "e러닝";
        case "05": case "5": return "CD";
        case "06": case "6": return "DVD";
        case "07": case "7": return "GIFT";
        case "08": case "8": return "화장품";
        case "09": case "9": return "웹소설/코믹";
        case "10": case "10": return "패션";
        case "통합검색": return "0";
        case "전체": return "0";
        case "UsedGoods": return "0";
        case "국내도서": return "1";
        case "외국도서": return "2";
        case "eBook": return "3";
        case "e-러닝": return "4";
        case "음반": return "5";
        case "CD": return "5";
        case "DVD/비디오": return "6";
        case "GIFT": return "7";
        case "화장품": return "8";
        case "ESTORY": case "웹소설/코믹": case "e연재": return "9";
        default: return "99";
    }
}
//인기검색어
function getMobilePopular() {
    _SearchType = getSearchType();
    var frontApiUrl = FRONT_API_URL + "/api/search/popular-words";
    $.ajax({
        url: frontApiUrl,
        dataType: "json",
        xhrFields: {
            withCredentials: true,
        },
        data: { wordCount: 10, searchType: _SearchType },
        success: function (data) {
            MobilePopularBack(data);
