// default값 
function modSizeDef() {
	//카드로 되돌리고
	if ($("#gdSizeWrap").hasClass("sizeIs_paper")) {
		$("#gdSizeWrap").removeClass("sizeIs_paper");
		$("#gdSizeWrap").addClass("sizeIs_card");
	}

	//3D가 있을 경우 3D는 전면
	if (!$("#gdSizeWrap").hasClass("sizeOnly")) {
		$("#gdSizeWrap .size3dCon .size3dUnit").removeClass("viewBack");
		$("#gdSizeWrap .size3dCon .size3dUnit").removeClass("viewSide");
		$("#gdSizeWrap .size3dCon .size3dUnit").removeClass("readyOn");
		$("#gdSizeWrap .size3dCon .size3dUnit").addClass("viewFront");
		$("#gdSizeWrap .size3dCon .size3dUnit .img_item").removeAttr("style");

		nowSizeAngle = 0; // angle초기화
	}
}

// 모드 변경
function chgSizeMod(str) {
	switch (str) {
		case "SIZE":
			if ($("#gdSizeWrap").hasClass("mod_3d")) {
				modSizeDef(); // default 
				$("#gdSizeWrap").addClass("mod_size");
				$("#gdSizeWrap").removeClass("mod_3d");

				calcGDSize();
			}
			break;
		case "3D":
			if ($("#gdSizeWrap").hasClass("mod_size")) {
				modSizeDef(); // default 
				$("#gdSizeWrap").addClass("mod_3d");
				$("#gdSizeWrap").removeClass("mod_size");

				//입체 적용
				gdSize3DApply($(window).width(), true);
			}
			break;
	}
}

