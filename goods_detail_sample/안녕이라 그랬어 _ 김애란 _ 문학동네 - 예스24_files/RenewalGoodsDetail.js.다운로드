        $("#nomiGoods_aipick").css("display", "none");
        $("#nomiGoods_nomi").css("display", "");
        $("#nomiGoods_many").css("display", "none");
    }
}

//2024 상품상세 리뉴얼: 상품상세 추천상품 영역 생성
function loadRecommendGoods(recommendGb, goodsNo, memId, callback) {
    if (typeof (memId) === 'undefined') {
        memId = '';
    }

    if (typeof (callback) === 'undefined') {
        callback = null;
    }

    var param = {
        method: "GET", headers: { "Content-Type": "application/json" }, timeout: 3000,
        url: "/Recommend/RecommendGoodsList?recommendGb=" + recommendGb + "&goodsNos=" + goodsNo + "&fromDetail=true&memId=" + memId,
        async: true, queryString: "",
        callback: function (html) {
            //추천상품 영역 생성
            var recommAreaId = recommendGb.toLowerCase();
            var recommArea = $(`#nomiGoods_${recommAreaId}`);
            var isPersona = false;
            const isNomiOrMany = recommendGb === "NOMI" || recommendGb === "MANY";

            if (html && html.trim()) {
                if (recommAreaId === "nomi") {
                    const nomiGoods = $("div[name='nomiGoods_nomi']");
                    nomiGoods.html(html);

                    if (!nomiGoods.find(".gdGRail .gdGLi li").length) {
                        handelEmptyRecommenArea(recommendGb);
                    }
                } else {
                    isPersona = JSON.parse(getHdPersonaFromHtmlString(html));

                    if (isPersona == true) {
                        recommArea = $("#nomiGoods_aipick");

                        $("#liAiPick").show();
                        $("#liMany").hide();
                        $("#nomiGoods_aipick").show();
                        $("#nomiGoods_nomi").hide();
                        $("#NomiG01").prop("checked", true);
                        $("#gdNomiGTopWrap").addClass("gdNomiG_2nd");
                        $("#gdNomiGTopWrap").find(".tm_grp").hide();

                        setNomiLabel();
                    }
                    recommArea.html(html);
                    if ((recommendGb === "NOMICATE" || recommendGb === "SIMILAR") && !recommArea.find(".gdGRail .gdGLi li").length) {
                        recommArea.parent().remove();
                    }
                }
            }
            else {
                if (isNomiOrMany) {
                    handelEmptyRecommenArea(recommendGb);
                } else if (recommendGb === "NOMICATE" || recommendGb === "SIMILAR") {
                    recommArea.parent().remove();
                }
            }

            setWelcomeLazyLoad($(".gdHorGRow img"));

            if (typeof (callback) === "function") {
                callback();
            }
        }
    };
    yes_ajax(param);
}
function getHdPersonaFromHtmlString(html) {
    const temp = document.createElement('div');
    temp.innerHTML = html;
    const el = temp.querySelector('#hdPersona');
    return el ? el.value : null;
}

function setNomiLabel(kind) {
    const $txt = $("#liNomi label .txt");
    if ($txt.length === 0) return;

    // 현재 문구에서 책/상품 자동 판별
    const current = $txt.text().replace(/\s+/g, " ").trim();
    const detected = (current.match(/(책|상품)\s*$/) || [])[1];

    const noun = kind || detected || "책"; // 기본값: 책

    $txt.text(`이 ${noun}과 함께 산 ${noun}`);
    $("#nomiText").text('나에게 맞는 추천');
}
function handelEmptyRecommenArea(recommendGb) {
    if (recommendGb === "NOMI") {
        $("#cateRecommend, div[name='nomiGoods_nomi']").remove();
        $("#nomiGoods_many").show();
    } else {
        $("#nomiGoods_many").hide();
    }

    $("#recommendTab").remove();

    changeRecommenText(recommendGb);
}
function changeRecommenText(recommendGb) {
    const titleText = $("#nomiText");
    const addText = recommendGb === "NOMI" ? " 많이" : " 함께";
    titleText.text((_, originalText) => {
        const target = "분들이";
        const index = originalText.indexOf(target);
        if (index !== -1) {
            return (
                originalText.slice(0, index + target.length) +
                addText +
                originalText.slice(index + target.length)
            );
        }
        return originalText; // '분들이'가 없으면 원래 텍스트 유지
    });
}


//2024 상품상세 리뉴얼: 다운로드 쿠폰 팝업 오픈 
function showCouponPopup(goodsNo, memNo) {
    if (!check_login_alert("쿠폰 다운로드는 로그인 후 이용할 수 있습니다.\r\n로그인 하시겠습니까?")) {
        return false;
    } else {
        if (isAjaxDoing == false && $("#dPop_couponDn").length == 0) {
            isAjaxDoing = true;

            const url = `${FRONT_API_URL}/Module/CouponInfomation?platform=m&goodsNo=${goodsNo}&memNo=${memNo}`;
            fetch(url, {
                method: 'GET', mode: 'cors', credentials: 'include'
            }).then(function (response) {
                return response.text();
            }).then(function (data) {
                $('#yesWrap').append(data);

                // body 스크롤 막기: 스크롤 막기전에 이미 막혀있으면 꼬임방지를 위해 스킵
                if (!$("body").hasClass("notScl") && !$("body").hasClass("schMod")) {
                    kFocusY = $(window).scrollTop();
                    $("html, body").addClass("notScl");
                    $("#yesWrap").css("top", -kFocusY);
                }

                isAjaxDoing = false;
            }).catch(function (error) {
                isAjaxDoing = false;
            });
        }
    }
}

