function commifyWithPlus(n) {
    var reg = /(^[+-]?\d+)(\d{3})/;
    n += '';

    while (reg.test(n))
        n = n.replace(reg, '$1' + ',' + '$2');

    if (n.substring(0, 1) != "-")
        n = "+" + n;

    return n;
}

