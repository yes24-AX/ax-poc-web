    //상품 유효성 확인
    var returnValidArrGoods = function (arrGoods, pageType, isCheckGoods, isCart, isOrder, isMyList) {
        var json = { errorCode: 0, result: true, msg: '', type: 'alert' };

        if (isCart == undefined || isCart == null) isCart = false;

        if (isOrder == undefined || isOrder == null) isOrder = false;

        if (isMyList == undefined || isMyList == null) isMyList = false;

        if (isCheckGoods == undefined || isCheckGoods == null) isCheckGoods = false;



        if (isMyList && !loginUDetail.checkLoginByMsg('로그인이 필요합니다.\r\n로그인 하시겠습니까?')) {
            json.errorCode = -10;
            json.result = false;
            json.type = "";
            return json;
        }

        if (arrGoods.length < 1) {
            var resultMsg = "상품의 옵션을 선택하세요.";
            if (isPartGoods != null && isPartGoods.toLowerCase() == "y") {
                resultMsg = "제본/분철 여부를 선택해 주세요.";
            }
            json.errorCode = -10;
            json.result = false;
            json.msg = resultMsg;
            return json;
        }
        else {
            var isOptChk = true;        //옵션 유효성 체크 여부

            switch (pageType) {
                case "ftcartreg":       //FTCartReg.aspx
                    isOptChk = false;
            }

            for (var i = 0; i < arrGoods.length; i++) {
                var goods = arrGoods[i];

                //eBook 상품 확인
                if (goods.resource_key == '12' || goods.resource_key == '13') {
                    if (!loginUDetail.checkLoginByMsg('eBook 상품은 로그인을 먼저 해주세요.\r\n로그인 하시겠습니까?')) {
                        json.errorCode = -10;
                        json.result = false;
                        json.type = "";
                    }
                    else {
                        //크레마클럽
                        if (goods.flat_rate_yn == 'Y' && goods.bookclue_yn == 'Y' && !isMyList && !isCart) {
                            if (goods.rent_goods_yn == 'N') {
                                if (!confirm('[크레마클럽] 서비스를 이용 중 이십니다.\n[크레마클럽] 이용 기간 동안은  본 상품을 무료로 이용하실 수 있습니다.\n\n추가로 해당 도서를 구매(소장) 하시겠습니까?\n아래 확인을 누르시면 결제가 진행 됩니다.')) {
                                    json.errorCode = -10;
                                    json.result = false;
                                    json.type = "";
                                }
                            }
                            else {
                                json.errorCode = -10;
                                json.result = false;
                                json.msg = "[크레마클럽] 서비스를 이용 중 이십니다.\n[크레마클럽] 이용 기간 동안은  본 상품을 무료로 이용하실 수 있습니다.\n\neBook App에서 본 상품을 다운로드 후 무료로 이용하세요!";
                            }
                        }
                    }
                }

                //e러닝 상품 확인
                if (goods.resource_key == '27' || goods.resource_key == '37' || goods.resource_key == '40') {
                    if (!loginUDetail.checkLoginByMsg('e러닝 상품은 로그인을 먼저 해주세요.\r\n로그인 하시겠습니까?')) {
                        json.errorCode = -10;
                        json.result = false;
                        json.type = "";
                    }
                }

                //상품 유효성
                if (!isMyList) {
                    //상품 상태 유효성
                    if (!(goods.goods_state == "01" || goods.goods_state == "02")) {
                        json.errorCode = -10;
                        json.result = false;
                        json.msg = "[" + goods.goods_name + "](일시품절 상품)은 카트에 담을 수 없는 상품입니다.";
                        if (isOrder) {
                            json.msg = "[" + goods.goods_name + "](일시품절 상품)은 구매 할 수 없는 상품입니다.";
                        }
                        break;
                    }

                    //주문 수량 유효성 확인
                    if (!goods.goods_cnt || goods.goods_cnt.toString() == "" || isNaN(goods.goods_cnt) || goods.goods_cnt.toString().indexOf(".") > -1) {
                        json.errorCode = -10;
                        json.result = false;
                        json.msg = "주문 수량을 확인해 주세요.";
                    }
                    else if (parseInt(goods.goods_cnt) == 0) {
                        json.errorCode = -10;
                        json.result = false;
                        json.msg = "1개 이상 구매 가능 합니다.";
                    }

                    //옵션별 주문 가능 갯수 체크
                    if (goods.max_cnt > 0 && goods.min_cnt > 0) {
                        if (goods.goods_cnt < goods.min_cnt || goods.goods_cnt > goods.max_cnt) {
                            json.errorCode = -10;
                            json.result = false;
                            json.msg = "선택옵션에 맞는 주문수량을 구매하셔야 옵션가격을 적용받으실 수 있습니다.";
                        }
                    }

                    //한정 판매 상품 재고 수량 확인 
                    if (goods.order_limit_yn == "Y") {
                        if (goods.goods_cnt > goods.order_remain_count) {
                            json.errorCode = -10;
                            json.result = false;
                            json.msg = "[" + goods.goods_name + "]의 재고수량이 부족합니다.";
                        }
                    }

                    //구매 제한 상품 최대 허용 주문 수량 확인
                    if (goods.order_limit_count > 0) {
                        if (goods.goods_cnt > goods.order_limit_count) {
                            json.errorCode = -10;
                            json.result = false;
                            json.msg = "[" + goods.goods_name + "]은(는) 최대허용 주문수량 [" + goods.order_limit_count + "]을 초과하였습니다.";
                        }
                    }

                    //옵션 문구 상품 유효성 : 문구 입력 확인
                    if (goods.opt_inst_yn == "Y" && isOptChk) {
                        if (goods.goods_message == undefined || goods.goods_message == null || goods.goods_message.trim() == "") {
                            json.errorCode = -10;
                            json.result = false;
                            json.msg = "문구를 입력해주세요.";
                            if (isCheckGoods || pageType.toLowerCase() != "detail")
                                json.msg = "옵션 문구 상품은 상품 상세 페이지에서 담을 수 있습니다.\r\n카트에 담지 못한 상품을 확인해주세요.\r\n\r\n상품명: [" + goods.goods_name + "]";
                            if (isOrder)
                                json.msg = "옵션 문구 상품은 상품 상세 페이지에서 구매하실 수 있습니다.\r\n상품을 확인해주세요.\r\n\r\n상품명: [" + goods.goods_name + "]";
                        }
                    }

                    //옵션 상품 유효성
                    if (goods.opt_yn == "Y" && isOptChk) {
                        if (goods.seq_no == undefined || goods.seq_no == null) {
                            json.errorCode = -10;
                            json.result = false;
