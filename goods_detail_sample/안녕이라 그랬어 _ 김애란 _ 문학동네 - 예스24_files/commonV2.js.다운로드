// 카트에 담긴 상품갯수 갱신
function cartNumberReflesh(type = "cart") {
    if ((typeof IS_BOT === "undefined" || !IS_BOT) && ((USERNO == 0 && getCookie("CART_NO") != null) || USERNO > 0)) {
        var CART_COUNT_KEY = "cartCountCache";
        var CART_COUNT_TIME_KEY = "cartCountCacheTime";
        var CART_COUNT_TTL = 60 * 1000; // 1분 (ms)
        var host = (window.location.host || "").toLowerCase();
        var referrer = document.referrer?.trim?.().toLowerCase?.() || "";

        // referrer에서 host만 추출
        var refHost = "";
        if (referrer) {
            try {
                var refUrl = new URL(referrer);
                refHost = (refUrl.hostname || "").toLowerCase();
            } catch (e) {
                refHost = "";
            }
        }

        // 레퍼러가 ssl 도메인 && 현재 호스트가 ssl이 아닌 yes24 도메인
        if (/^(?:[a-z0-9-]*ssl)\.yes24\.com$/i.test(refHost) && /\.yes24\.com$/.test(host) && host.indexOf("ssl") === -1) {
            window.sessionStorage.removeItem(CART_COUNT_KEY);
            window.sessionStorage.removeItem(CART_COUNT_TIME_KEY);
        }

        // type이 "cart"가 아닌 경우, 세션 스토리지 캐시 값 사용 (1분 이내)
        if (type !== "cart") {
            try {
                var cachedCount = window.sessionStorage.getItem(CART_COUNT_KEY);
                var cachedTime = window.sessionStorage.getItem(CART_COUNT_TIME_KEY);

                if (cachedCount !== null && cachedTime !== null) {
                    var elapsed = new Date().getTime() - parseInt(cachedTime, 10);
                    if (elapsed < CART_COUNT_TTL) {
                        updateCartCountUI(parseInt(cachedCount, 10));
                        return;
                    }
                }
            } catch (e) { }
        }
        ajaxNoCache();
        try {
            $.ajax({
                url: FRONT_API_URL + '/api/goods/cartCount',
                type: 'GET',
                dataType: 'json',
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    var cartCount = parseInt(data.CartCount, 10);
                    if (isNaN(cartCount) || cartCount < 0) { cartCount = 0; }
                    // 세션 스토리지에 카트 수량 및 호출 시각 저장
                    try {
                        window.sessionStorage.setItem(CART_COUNT_KEY, cartCount.toString());
                        window.sessionStorage.setItem(CART_COUNT_TIME_KEY, new Date().getTime().toString());
                    } catch (e) { }
                    updateCartCountUI(cartCount);
                }
            });
        }
        catch (e) { }
    }
}

