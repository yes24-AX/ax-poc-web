var _dispNo, _url;
var _callback = null;
var _failCallback = null;

// 즐겨찾기 추가
var addFavorite = function (dispNo, url, callback, failCallback) {
    _dispNo = dispNo;
    _url = url;
    _callback = callback;
    _failCallback = failCallback;

    if (!check_login()) {
        basicDialog.confirm('알림', '즐겨찾기는 로그인 후 이용할 수 있습니다.<br/>로그인 하시겠습니까?', '확인', '취소', goLoginPage);
    }
    else {
        addFavoriteAjax(dispNo, url, callback, failCallback);
    }
    return;
}

// Post로 즐겨찾기 서버로 전송
var addFavoriteAjax = function (dispNo, url, callback, failCallback){
    var ajax_url = getMoblieFavoriteUrl("/Main/AddFavorite");

    // 포스트 방식으로 Json 요청
    $.post(ajax_url,
            { dispNo: dispNo, favoriteurl: url },
            function (data) {
                data = convertJSON(data);
                if (data.IsSuccess) {
                    refreshFavorite();

                    // callback 함수가 정의 된경우 실행
                    if (callback != null && callback != undefined)
                        callback();
                }
                else {
                    // failCallback 함수가 정의 된경우 실행
                    if (failCallback != null && failCallback != undefined)
                        failCallback();
                    else                        
                        oneBtnDialog.show('알림', '인터넷연결이 원활하지 않습니다.<br/>다시 한번 시도 해주세요', '확인');
                }
            },
            "json");
}

