//즐겨찾는 분야 URL 조회
var getMoblieFavoriteUrl = function (url) {
    var protocol = window.location.protocol;
    var _url = _MOBILE_URL + url;
    if (isPaymentSite) {
        _url = _MOBILE_URL + '/ProxyMobile/Execute?url='
        _url += escape(MOBILE_HTTP_URL + url) + "&isPost=true";
    }
    return _url;
}

// 즐겨찾기 삭제 AJAX
var removeFavoriteAjax = function () {
    loadingShow();

    var url = getMoblieFavoriteUrl("/Main/RemoveFavorite");
    var currentUrl = protocol + "//" + window.location.host;

    // 포스트 방식으로 Json 요청
    $.ajax({
        url: url,
        data: { dispNo: _dispNo, currentUrl: currentUrl },
        type: "POST",
        xhrFields: {
            withCredentials: true
        },
        crossDomain: true,
        success: function (data) {
            data = convertJSON(data);
            if (data.IsSuccess) {
                refreshFavorite();

                // callback 함수가 정의 된경우 실행
                if (_callback != null && _callback != undefined)
                    _callback();
            }
            else {
                oneBtnDialog.show('알림', '인터넷연결이 원활하지 않습니다.\n다시 한번 시도 해주세요', '확인');
            }
        },
        fail: function (xhr, status, errorMsg) {
            ajaxAlert(xhr, status, errorMsg);
        }
    });

    loadingHide(); // 로딩 화면 삭제
}

// JSON 여부 판단후 변환후 반환
var convertJSON = function (data) {
    var jsonData = data;
    if (typeof (data) == "string") {
        jsonData = $.parseJSON(data);
    }
    return jsonData;
}

