//간편결제 팝업 노출
function showQuickPayment() {
    const params = [];
    if (typeof multi_option_array === 'object') {
        Object.keys(multi_option_array).forEach(key => {
            const item = multi_option_array[key];
            params.push(`quickPaymentGoods[${key}].Goods_No=${encodeURIComponent(g_GoodsNo)}`);
            params.push(`quickPaymentGoods[${key}].Goods_Seq=${encodeURIComponent(item.goods_seq)}`);
            params.push(`quickPaymentGoods[${key}].Goods_Cnt=${encodeURIComponent(item.count)}`);
        });
    } else {
        params.push(`quickPaymentGoods[0].Goods_No=${encodeURIComponent(g_GoodsNo)}`);
        params.push(`quickPaymentGoods[0].Goods_Seq=1`);
        params.push(`quickPaymentGoods[0].Goods_Cnt=${encodeURIComponent($("*[name='ORD_CNT']").val())}`);
    }

    const formData = params.join("&");
    const showQuickPaymentConfig = new RequestConfig({
        domain: MOBILE_HTTP_URL,
        url: "/Goods/QuickPayment",
        method: 'POST',
        headers: {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        bodyData: formData,
        responseType: "text",
        callback: setQuickPaymentDetail
    })

    fetchApi(showQuickPaymentConfig);

    //토근생성
    getQuickPaymentSignature();
}

//빠른결제 유효성검증 토큰 생성
function getQuickPaymentSignature() {
    const quickPaymentSignatureConfig = new RequestConfig({
        domain: MOBILE_HTTP_URL,
        url: "/Goods/getQuickPaymentSignature",
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        callback: getQuickPaymentMethod
    })
    fetchApi(quickPaymentSignatureConfig);
}

//간편결제 수단 조회
function getQuickPaymentMethod(data) {
    quickPaymentToken.Timestamp = data.Timestamp;
    quickPaymentToken.Token = data.Token;
    quickPaymentToken.Signature = data.Signature;

    const quickPaymentMethodConfig = new RequestConfig({
        domain: SSL_API_URL,
        url: "/api/QuickPayment/GetMethods",
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-QuickPayment-Platform": "yes24"
        },
        bodyData: quickPaymentToken,
        responseType: "json",
        callback: renderQuickPaymentLayer,
        timeout : 10000
    })

    fetchApi(quickPaymentMethodConfig);
}

