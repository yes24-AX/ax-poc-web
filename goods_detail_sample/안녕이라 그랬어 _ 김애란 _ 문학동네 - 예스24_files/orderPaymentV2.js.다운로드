    var getJsonObj = function (optionObj) {
        optionObj = JSON.parse(optionObj);
        const filteredItems = [optionObj].filter(item => 'opt_full_name' in item);
        if (filteredItems.length > 0) {
            optionObj.opt_full_name = optionObj.opt_full_name.replace(/'/g, "&apos;").replace(/"/g, "&quot;");
        }
