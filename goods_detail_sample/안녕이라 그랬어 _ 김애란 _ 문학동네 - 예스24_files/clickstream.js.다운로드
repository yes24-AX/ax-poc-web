        //모바일인경우
        if (current_domain.indexOf("mdev.yes24.com") > -1 || current_domain.indexOf("m.yes24.com") > -1) {
            page_code = getPagecodeFromUrl("M");
        }
        //결제인경우
        else if (current_domain.indexOf("ssl.yes24.com") > -1 || current_domain.indexOf("restruction.yes24.com") > -1) {
            page_code = getPagecodeFromUrl("SSL");
        }
        //PC검색인경우
        else if (current_path.indexOf("/searchcorner/") > -1) {
            page_code = "BZA";
        }
        else {
            try {
                caller_func_name = arguments.callee.caller.name.toLowerCase();
                if (caller_func_name == "setcode") {
                    caller_func_name = arguments.callee.caller.caller.name.toLowerCase();
                }

                switch (caller_func_name) {
                    case "setwcode": page_code = getPagecodeFromUrl("P"); break;    //월컴 or 헤더
                    case "setcdcode": page_code = "CAA"; break;                     //국내도서
                    case "setcfcode": page_code = "CBA"; break;                     //외국도서
                    case "setcecode": page_code = "CCA"; break;                     //eBook
                    case "setcmcode": page_code = "CFA"; break;                     //CD/LP
                    case "setcvcode": page_code = "CGA"; break;                     //DVD,BD
                    case "setcgcode": page_code = "CJA"; break;                     //GIFT
                    case "setcucode": page_code = "CKA"; break;                     //중고샵
                    case "setscode": page_code = "BZA"; break;                      //검색
                    case "setpcode": page_code = "IAA"; break;                      //상품상세
                    case "setocode": page_code = "KAA"; break;                      //카트
                    case "setbccode": page_code = getPagecodeFromUrl("P"); break;   //북클럽
                    case "setpscode": page_code = "RAA"; break;                      //파트너샵
                    case "setcuhcode": page_code = "UAA"; break;                      //중고샵허브
                    case "setcuscode": page_code = "TAA"; break;                      //중고매장
                    default: page_code = getPagecodeFromUrl("P"); break;
                }
            } catch (e) { page_code = getPagecodeFromUrl("P"); }
        }
        if (isDebug === true) {
            console.log("LogCode:" + log_code + ", PageCode:" + page_code);
        }
        
        try {
            // 모바일장치 여부 체크
            var mobileDevices = /Android|BlackBerry|iPhone|iPad|iPod|Opera Mini|IEMobile/i;
            var isMobile = (mobileDevices).test(navigator.userAgent);

            //var ua = navigator.userAgent.toLocaleLowerCase();
            if (isMobile) {
                sendClickstream_GET(log_code, page_code, extra_code);
            }
            else{
                sendClickstream_POST(log_code, page_code, extra_code);
            }
            //if (log_code != "001_007") {
            //    alert(page_code + " : " + log_code);
            //}
        } catch (e) { if (isDebug === true) { console.dir(e); } }
    };

    //PCID 세팅
    document.addEventListener("DOMContentLoaded", function () {
        var user_pcid = getCookieValue("PCID");
        if (user_pcid != null && user_pcid !== "") {
            return;
        }
        var pcid_value = new Date().getTime();
        setCookieVal("PCID", pcid_value, 1);
    });

    return {
        setClickstreamLog: setClickstreamLog
    }
})(clickstream || {});




